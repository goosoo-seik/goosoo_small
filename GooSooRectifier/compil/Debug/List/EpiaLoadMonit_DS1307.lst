    949          
    950          				case 'W':
    951          				case 'w':	DS1307_writebyte(0,0);	break;
    952          			}
    953          			break;
    954          
    955          			case 'C':
    956          			case 'c':
    957          			printf("\rEnter Clock Routine to run:C");
    958          			if (bPushKey) M = bPushKey; 
    959          
    960          			switch(M1)
