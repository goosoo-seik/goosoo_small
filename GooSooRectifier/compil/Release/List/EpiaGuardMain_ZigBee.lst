   \                                 In segment DATA_Z, align 1, align-sorted
    645          char ZCMdpMode;
   \                     ZCMdpMode:
   \   00000000                      DS8 1
    646          char PacketLength;
   \                     PacketLength:
   \   00000001                      DS8 1

   \                                 In segment CODE, align 4, keep-with-next
