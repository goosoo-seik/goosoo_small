    125          char ModemCts, ModemCts0;
    126          void modem_cts_monit(void)
    127          {
    128            ModemCts = (pio_read(PIOA) & MODEM_CTS) >> 9;
    129            if (ModemCts0 != ModemCts) 
    130              if (ModemCts) printf("\n>MODEM CTS CLEAR"); 
    131               else printf("\n>MODEM CTS SET");
    132            ModemCts0 = ModemCts;
    133          }
    134          
    135          #define	MODEM_RTS_ON	10
    136          #define	MODEM_RTS_OFF	20
    137          #define	MODEM_ARCRM129	30
    138          #define	MODEM_ATS0	40
    139          #define	MODEM_ATE0	50
    140          #define	MODEM_SEVER_CALL 60
    141          #define	MODEM_END_CODE	70
    142          #define	MODEM_MONIT	80
    143          #define	MODEM_POWER_ON	90
    144          #define	MODEM_POWER_OFF	100
    145          #define	MODEM_WAIT	200
    146          void modem_control_function(void)
    147          {
    148            modem_cts_monit();
    149            switch (sExecStep)
    150           {   
    151            case 0:
    152              display_mode(0);
    153              sExecStep++;
    154              return;
    155              
    156            case 1:
    157              screen_clear();
    158              debug_monit(MONOUT);
    159              printf("<< MODEM Control >>");
    160              printf("\n1:RTS ON  2:RTS OFF ");
    161              printf("\n3:AT+CRM=129 4:ATS=0");
    162              printf("\n5:ATE0    6:SV_CALL ");
    163              printf("\n7:^]+++^[ 8:MONIT   ");
    164              printf("\n9:POWER ON 0:OFF    ");
    165              
    166              printf("\n[MENU]:goto MAIN");
    167              sExecStep++;
    168              return;
    169            
    170            case 2:
    171            if (bPushKey == '1') sExecStep = MODEM_RTS_ON;
    172              else if (bPushKey == '2') sExecStep = MODEM_RTS_OFF;
    173              else if (bPushKey == '3') sExecStep = MODEM_ARCRM129;
    174              else if (bPushKey == '4') sExecStep = MODEM_ATS0;
    175              else if (bPushKey == '5') sExecStep = MODEM_ATE0;
    176              else if (bPushKey == '6') sExecStep = MODEM_SEVER_CALL;
    177              else if (bPushKey == '7') sExecStep = MODEM_END_CODE;
    178              else if (bPushKey == '8') sExecStep = MODEM_MONIT; 
    179              else if (bPushKey == '9') sExecStep = MODEM_POWER_ON; 
    180              else if (bPushKey == '0') sExecStep = MODEM_POWER_OFF; 
    181              else if (bPushKey == 'b') sExecStep++; 
    182              else if (bPushKey == 'c') sExecStep++; 
    183              else if (bPushKey == 'a') 
    184              {
    185                sExecStep = 0;
    186                ExecMode = MAIN_MENU;
    187               }
    188              return;
    189            
    190            case 3:
    191              sExecStep = 1;
    192              return; 
    193           
    194            case 4:
    195              return;
    196          
    197              
    198            case MODEM_RTS_ON:
    199              screen_clear();
    200              pio_clear(PIOA, MODEM_RTS);
    201              printf("\n>MODEM RTS SET");
    202              sExecStep = MODEM_WAIT;
    203              return;
    204              
    205            case MODEM_RTS_OFF:
    206              screen_clear();
    207              pio_set(PIOA, MODEM_RTS);
    208              printf("\n>MODEM RTS CLEAR");
    209              sExecStep = MODEM_WAIT;
    210              return;
    211              
    212            case MODEM_ARCRM129:
    213              screen_clear();
    214              putstring1(ATCRM129);
    215              sExecStep = MODEM_WAIT;
    216              return;
    217              
    218            case MODEM_ATS0:
    219              screen_clear();
    220              putstring1(ATS01);
    221              sExecStep = MODEM_WAIT;
    222              return;
    223              
    224            case MODEM_ATE0:
    225              screen_clear();
    226              putstring1(ATS01);
    227              sExecStep = MODEM_WAIT;
    228              return;
    229              
    230            case MODEM_SEVER_CALL:
    231              screen_clear();
    232              putstring1(SEVER_CALL);
    233              sExecStep = MODEM_WAIT; 
    234              return;
    235              
    236            case MODEM_END_CODE:
    237              screen_clear();
    238              putstring1(END_CODE);
    239              printf("\n^[+++^[");
    240              sExecStep = MODEM_WAIT;
    241              return;  
    242              
    243            case MODEM_MONIT:  
    244              screen_clear();
    245              printf("\n<MODEM status monit>");
    246              printf("\nPress key:Monit END");
    247              sExecStep++;  
    248              return;
    249              
    250            case MODEM_MONIT+1:   
    251              debug_monit(MONOUT);
    252              sExecStep++;    
    253              return;
    254              
    255            case MODEM_MONIT+2:
    256              if (bPushKey != 0) sExecStep = 1;
    257              if (RxUSART1) printf("%1c", getchar1());
    258              return;
    259              
    260            case MODEM_POWER_ON:
    261              screen_clear();
    262              MODEMpower(ON);
    263              printf("\nModem Power ON");
    264              sExecStep = MODEM_WAIT;
    265              return;
    266              
    267            case MODEM_POWER_OFF:
    268              screen_clear();
    269              MODEMpower(OFF);
    270              printf("\nModem Power OFF");
    271              sExecStep = MODEM_WAIT;  
    272              return;
    273              
    274            case MODEM_WAIT:
    275              printf("\nPress key..\n");
    276              debug_monit(MONOUT+COM2OUT);
    277              sExecStep++;
    278              return;
    279              
    280            case MODEM_WAIT+1:
    281              if (RxUSART1) printf("%1c",getchar1()); 
    282              if (bPushKey == 'a') sExecStep = 1;
    283              else if (bPushKey == 'b') putstring1(PK_SAMPLE);
    284              else if (bPushKey != 0) 
    285              {
    286                putchar1(bPushKey);
    287                printf("%1c",bPushKey);
    288              }
    289              return;
    290           };
    291          }
