# 이 파일을 .env 로 복사한 뒤 값을 채우고 서버를 재시작하세요.
PORT=3000
SESSION_SECRET=long-random-string

# 인증 성공 후 열릴 HTML (비워두면 ..\dcs_uart_viewer.html)
VIEWER_FILE=

# Authenticator 앱에 표시될 서비스명 (선택). 예: "회사명 (MyService)"
OTP_ISSUER=

# ───── SMTP (필수: 없으면 QR 메일 전송 불가) ─────
# 아래 예시 중 하나를 골라 주석(#)을 풀어 사용

# [A] Gmail  — 구글 계정 2단계 인증 켜기 → https://myaccount.google.com/apppasswords 에서 앱 비밀번호(16자리) 발급
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM=OTP 안내 <your.account@gmail.com>

# [B] Microsoft 365 / Outlook — 관리 센터에서 해당 사서함의 "인증된 SMTP" 허용 필요
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=otp@yourcompany.com
# SMTP_PASS=비밀번호
# MAIL_FROM=otp@yourcompany.com

# [C] 네이버 — 메일 환경설정 > POP3/SMTP 사용 설정
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=naverid@naver.com
# SMTP_PASS=비밀번호(2단계 인증 시 애플리케이션 비밀번호)
# MAIL_FROM=naverid@naver.com

# [D] 사내 메일 서버 — IT 팀에 호스트/포트/계정 문의

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
