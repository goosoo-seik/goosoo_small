     14          // LCD GM12321 Command Listing
     15          #define LCD_ON        	0xAF  // LCD display ON
     16          #define LCD_OFF       	0xAE  // LCD display OFF
     17          #define LCD_DP_START  	0xC0  // 0 - 31 : RAM line corresponding to top line of display 
     18          #define LCD_PAGE_ADD  	0xB8  // 0 -  3 : Set RAM page address in page address register
     19          #define LCD_COL_ADD   	0x00  // 0-72 : Set display RAM column address in page column register
     20          #define LCD_ADC_CW    	0xA0  // CW out
     21          #define LCD_ADC_CCW   	0xA1  // CCW out
     22          #define LCD_DRV_STATIC  0xA5  // Static drive
     23          #define LCD_DRV_NORMAL  0xA4  // Normal drive
     24          #define LCD_DUTY16    	0xA8  // 1/16
     25          #define LCD_DUTY32    	0xA9  // 1/32
     26          #define LCD_MODI_ON   	0xE0  // Read? Modify? Write ON
     27          #define LCD_MODI_OFF  	0xEE  // Read? Modify? Write OFF
     28          #define LCD_SOFT_RST  	0xE2  // LCD software reset
     29          
     30          #define PAGE_SIZE       61	// LCD page size 
     31          #define LCD_LINE_SIZE   122	// LCD`line length
     32          #define LCD_BUF_SIZE    LCD_LINE_SIZE * 4
     33          #define DP_SCAN_TIME    16    // 1 page scan time : 16 x 2 = 32 ms
     34          // charactor q'ty per line
     35          #define FONT6_LINE	20
     36          #define FONT8_LINE	15
     37          #define FONT16_LINE	15//7
     38          // charactor q'ty per page
     39          #define FONT6_PAGE	80	
     40          #define FONT8_PAGE	30
     41          #define FONT16_PAGE	30//14
     42          //#define DP_LINE_SIZE    20
     43          //#define DP_LINE_SIZE1   15
