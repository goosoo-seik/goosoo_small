   \   00000006   0023               MOVS     R3,#+0
   \   00000008   05E0               B        ??MakeCrc16_1
    132          	{
    133          		crc = (crc & 0xff00) | (crc ^ (unsigned short)(ptr[uitmp] & 0xff));
    134          		for(uctmp = 0;uctmp < 8;uctmp++)
    135          		{
    136          			if(crc & 0x0001)
