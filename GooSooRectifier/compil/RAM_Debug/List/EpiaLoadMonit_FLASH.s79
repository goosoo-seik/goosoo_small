//  115 
//  116 /*-------------------------------*/
//  117 /* Flash Status Field Definition */
//  118 /*-------------------------------*/
//  119 
//  120 #define AT91C_MC_FSR_MVM	((unsigned int) 0xFF << 8)		// (MC) Status Register GPNVMx: General-purpose NVM Bit Status
//  121 #define AT91C_MC_FSR_LOCK	((unsigned int) 0xFFFF << 16)	// (MC) Status Register LOCKSx: Lock Region x Lock Status
//  122 #define	ERASE_VALUE 		0xFFFFFFFF
//  123 #define FLASH_PAGE_SIZE_BYTE	256
//  124 #define TRUE  (1==1)
//  125 #define FALSE (0==1)
//  126 #define true  (1==1)
//  127 #define false (0==1)
//  128 
//  129 //extern void po_unlock(void);
//  130 //extern void po_lock(void);
//  131 
//  132 //*----------------------------------------------------------------------------
//  133 //* \fn    AT91F_Flash_Ready
//  134 //* \brief Wait the flash ready
//  135 //*----------------------------------------------------------------------------

        RSEG CODE_I:CODE:NOROOT(2)
        THUMB
//  136 __ramfunc int AT91F_Flash_Ready (void)
//  137 {
AT91F_Flash_Ready:
        PUSH     {LR}
//  138   unsigned int status;
//  139   char time;
//  140   
//  141   status = 0;
//  142   time = 255;
        MOVS     R1,#+255
//  143   
//  144   //* Wait the end of command
//  145   while (((status & AT91C_MC_FRDY) != AT91C_MC_FRDY )&(time != 0))
//  146   {
//  147     status = AT91F_MC_EFC_GetStatus( AT91C_BASE_MC );
??AT91F_Flash_Ready_0:
        MOVS     R0,#+151
        MVNS     R0,R0            ;; #-152
        LDR      R0,[R0, #+0]
//  148     time--;
        SUBS     R1,R1,#+1
        LSLS     R1,R1,#+24
        LSRS     R1,R1,#+24
//  149   }
        LSLS     R2,R0,#+31
        BMI      ??AT91F_Flash_Ready_1
        MOVS     R2,R1
        BNE      ??AT91F_Flash_Ready_0
//  150   return status;
??AT91F_Flash_Ready_1:
        POP      {R1}
        BX       R1               ;; return
//  151 }

