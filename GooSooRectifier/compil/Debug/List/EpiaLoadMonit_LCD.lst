     27          #define LCD_ADC_CCW   	0xA1  // CCW out
     28          #define LCD_DRV_STATIC  0xA5  // Static drive
     29          #define LCD_DRV_NORMAL  0xA4  // Normal drive
     30          #define LCD_DUTY16    	0xA8  // 1/16
     31          #define LCD_DUTY32    	0xA9  // 1/32
     32          #define LCD_MODI_ON   	0xE0  // Read? Modify? Write ON
     33          #define LCD_MODI_OFF  	0xEE  // Read? Modify? Write OFF
     34          #define LCD_SOFT_RST  	0xE2  // LCD software reset
     35          
