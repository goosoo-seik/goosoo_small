//  718 void rxpacket_parser(void)
//  719 {
rxpacket_parser:
        PUSH     {R0,R4,R5,LR}
//  720   if (ZCMrxBuffer[3] == 0)  	// APP_KVP packet
        LDR      R4,??DataTable28  ;; ZCMrxBuffer
        LDRB     R1,[R4, #+3]
        LDR      R5,??rxpacket_parser_0  ;; `?<Constant "\\nDev:%02X Packet:%01x">`
        LDR      R0,??rxpacket_parser_0+0x4  ;; sEndDevice
        CMP      R1,#+0
        BNE      ??rxpacket_parser_1
//  721   {
//  722      sEndDevice[0] = ZCMrxBuffer[10] + (ZCMrxBuffer[11]<<8);
        LDRB     R1,[R4, #+10]
        LDRB     R2,[R4, #+11]
        LSLS     R2,R2,#+8
        ADDS     R1,R1,R2
        STRH     R1,[R0, #+0]
//  723      printf("\nDev:%02X Packet:%01x", sEndDevice[0], ZCMrxBuffer[19]);
        LDRB     R2,[R4, #+19]
        LDRH     R1,[R0, #+0]
        MOVS     R0,R5
        _BLF     printf,??printf??rT
//  724      if (ZCMrxBuffer[20] == 2) printf("[OK]");
        LDRB     R0,[R4, #+20]
        CMP      R0,#+2
        BNE      ??rxpacket_parser_2
        ADDS     R5,R5,#+24
        MOVS     R0,R5
        _BLF     printf,??printf??rT
        POP      {R3-R5,PC}
//  725   }
//  726   else if (ZCMrxBuffer[3] == 1)	// APP_MSG packet
??rxpacket_parser_1:
        CMP      R1,#+1
        BNE      ??rxpacket_parser_2
//  727   {
//  728     sEndDevice[0] = ZCMrxBuffer[10] + (ZCMrxBuffer[11]<<8);
        LDRB     R1,[R4, #+10]
        LDRB     R2,[R4, #+11]
        LSLS     R2,R2,#+8
        ADDS     R1,R1,R2
        STRH     R1,[R0, #+0]
//  729     printf("\nJoin:%02X", sEndDevice[0]);
        LDRH     R1,[R0, #+0]
        MOVS     R0,R5
        ADDS     R0,R0,#+32
        _BLF     printf,??printf??rT
//  730     printf(" AD:%02X%02X%02X%02X", ZCMrxBuffer[21], ZCMrxBuffer[22], ZCMrxBuffer[23], ZCMrxBuffer[24]);
        SUB      SP,SP,#+4
        LDRB     R0,[R4, #+24]
        PUSH     {R0}
        LDRB     R3,[R4, #+23]
        LDRB     R2,[R4, #+22]
        LDRB     R1,[R4, #+21]
        ADDS     R5,R5,#+44
        MOVS     R0,R5
        _BLF     printf,??printf??rT
        ADD      SP,SP,#+8
//  731   }
//  732 }
??rxpacket_parser_2:
        POP      {R3-R5,PC}       ;; return
        Nop      
        DATA
??rxpacket_parser_0:
        DC32     `?<Constant "\\nDev:%02X Packet:%01x">`
        DC32     sEndDevice

