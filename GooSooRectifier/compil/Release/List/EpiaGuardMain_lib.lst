    499          
    500          
    501          void all_led_onoff(char onoff)
    502          {
    503            if (onoff == 0) 
    504            {
    505             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    506             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED2);
    507             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    508             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    509            } 
    510            else 
    511            {
    512              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    513              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED2 );
    514              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    515              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    516            };
    517          }
    518          
    519          void led_rotate(void)
    520          {
    521            int i;
    522                  // Once a Shot on each led
    523          	for ( i=0 ; i < AT91B_NB_LEB ; i++ )
    524                  {
    525          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    526          	    wait();
    527          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    528          	    wait();
    529                  }// End for
    530                 
    531                  // Once a Shot on each led
    532                  for ( i=(AT91B_NB_LEB-1) ; i >= 0 ; i-- )
    533                  {
    534          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    535          	    wait();
    536          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    537          	    wait();
    538                  } 
    539          }
    540          
    541          //--------------------------------------------------------------------------------------
    542          // Function Name       : change_speed
    543          // Object              : Adjust "LedSpeed" value depending on SW1 and SW2 are pressed or not
    544          // Input Parameters    : none
    545          // Output Parameters   : Update of LedSpeed value.
    546          //--------------------------------------------------------------------------------------
    547          void change_speed ( void )
    548          {
    549              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW1) == 0 )
    550              {
    551                  if ( LedSpeed > SPEED ) LedSpeed -=SPEED ;
    552              }
    553              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW2) == 0 )
    554              {
    555                  if ( LedSpeed < AT91B_MAIN_OSC ) LedSpeed +=SPEED ;
    556              }
    557          }
    558          
    559          //--------------------------------------------------------------------------------------
    560          // Function Name       : wait
    561          // Object              : Software waiting loop
    562          // Input Parameters    : none. Waiting time is defined by the global variable LedSpeed.
    563          // Output Parameters   : none
    564          //--------------------------------------------------------------------------------------
    565          void wait ( void )
    566          {// Begin
    567              unsigned int waiting_time ;
    568              change_speed () ;
    569              for(waiting_time = 0; waiting_time < LedSpeed; waiting_time++) ;
    570          }// End
    571          
    572          void led_shift(void)
    573          {
    574           unsigned char no;
    575            led_onoff(LEDno, LEDon);
    576            no = change_led(LEDno);
    577            if (no != LEDno) 
    578            {
    579              led_onoff(LEDno, 0);
    580              LEDno = no;
    581            }
    582            LEDon ^= 1; 
    583          }
