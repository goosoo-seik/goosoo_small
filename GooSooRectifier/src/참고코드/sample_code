// LCD Command Listing
#define LCD_ON        	0xAF  // LCD display ON
#define LCD_OFF       	0xAE  // LCD display OFF
#define LCD_DP_START  	0xC0  // 0 - 31 : RAM line corresponding to top line of display 
#define LCD_PAGE_ADD  	0xB8  // 0 -  3 : Set RAM page address in page address register
#define LCD_COL_ADD   	0x00  // 0-72 : Set display RAM column address in page column register
#define LCD_ADC_CW    	0xA0  // CW out
#define LCD_ADC_CCW   	0xA1  // CCW out
#define LCD_DRV_STATIC  0xA5  // Static drive
#define LCD_DRV_NORMAL  0xA4  // Normal drive
#define LCD_DUTY16    	0xA8  // 1/16
#define LCD_DUTY32    	0xA9  // 1/32
#define LCD_MODI_ON   	0xE0  // Read? Modify? Write ON
#define LCD_MODI_OFF  	0xEE  // Read? Modify? Write OFF
#define LCD_SOFT_RST  	0xE2  // LCD software reset
#define DP_SCAN_TIME    8     // 1 page scan time : 8 x 4 = 32 ms

