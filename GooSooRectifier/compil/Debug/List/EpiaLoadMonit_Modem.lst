     58          /********************************************/
     59          /* RFID Reader data receive from ETS reader */
     60          /* This function must locate in main loop   */ 
     61          /********************************************/
     62          void modem_control(void)
     63          {
     64            unsigned char data;
     65            //char index;
     66            switch (StepMDM) 
     67            {
     68            case 0:   // Reading stop status
     69             // 정지상태에서는 수신된 데이터를 포기
     70             if (rx_rd_index1 != rx_wr_index1) data = getchar1();
     71             return;
     72           
     73            case 1:   // 수신을 준비, 데이터가 수신되면 다음 단계로 이동
     74              RxMDM = 0;
     75              ErrMDM = 0;
     76              ErrUsart1 = 0;
     77              WaitMDM = 0;
     78              if (RxUSART1) StepMDM++;
     79              return;
     80           
     81            case 2:   // 일단 수신된 모든 데이터를 read
     82              while (RxUSART1) 
     83              {
     84                 printf("%02X",data);          // test code
     85                 RxBufMDM[RxMDM++] = data;
     86                 WaitMDM = 0;
     87              }
     88              // 5 cycle(10mS) 동안 데이터 수신이 없으면  데이터 수신 종료
     89              if (++WaitMDM > 5) StepMDM++;
     90              return;
     91           
     92            case 3:   // 수신된 데이터를 검사
     93              ErrMDM = 0;
     94              StepETS++;
     95              return;
     96              
     97            case 4:   // 수신되 데이터를 처리
     98           
     99              if (ErrMDM == 'B') print_str("\nID>Buffer Full..\3");
    100              else if (ErrMDM == 'O') print_str("\nID>OverFlow Err..\3");
    101              else if (ErrMDM == 'P') print_str("\nID>Parity Err..\3");
    102              else if (ErrMDM == 'F') print_str("\nID>Frame Err..\3");
    103              else if (ErrMDM == 'T') print_str("\nID>TimeOut Err..\3");
    104              else if (ErrMDM == 1) print_str("\nID>STX Err..\3");
    105              else if (ErrMDM == 2) print_str("\nID>ETX Err..\3");
    106              else if (ErrMDM == 3) print_str("\nID>Data Long..3");
    107              else if (ErrMDM == 4) print_str("\nID>Data short..\3"); 
    108              else if (ErrMDM == 5) print_str("\nID>Data not Hex..\3");
    109              else if (ErrMDM == 6) print_str("\nID>Same Card Use..\3");
    110              else if (ErrMDM == 7) print_str("\nID>Buffer Full!\3");
    111              
    112              StepMDM++;
    113              return;
    114          
    115            case 5:
    116              ErrMDM = 0;
    117              StepMDM = 1;    // 데이터 수신을 반복
    118              return;
    119           }
    120          }
