    122          void AT91SAM7X_Enumerate(void);
    123          
    124          void USB_c_irq_handler(void)
    125          {
    126            AT91PS_UDP  UDP_pt = AT91C_BASE_UDP;
    127            unsigned int isr;
    128            
    129            isr = UDP_pt->UDP_ISR;
    130            
    131            if (isr & (1<<0)) // Reset Interrupt
    132            {
    133              UDP_pt->UDP_ICR = 1<<12;  
    134              // All EndPoint's FIFO clear.RX_VYTE_COUNTER is 0.
    135              UDP_pt->UDP_RSTEP = 0xFFFFFFFF;
    136              UDP_pt->UDP_RSTEP = 0; 
    137              // Function Enable
    138              UDP_pt->UDP_FADDR = 1<<8; 
    139              // EndPoint Enable(1), EndPoint type: Control(000)
