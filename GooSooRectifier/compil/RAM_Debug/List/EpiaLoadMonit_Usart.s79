// __??Code16?? __code __interwork __atpcs void AT91F_PDC_Open(AT91PS_PDC)
AT91F_PDC_Open:
        MOVS     R1,#+2
        STR      R1,[R0, #+32]
        LSLS     R1,R1,#+8
        STR      R1,[R0, #+32]
        MOVS     R1,#+0
        STR      R1,[R0, #+24]
        STR      R1,[R0, #+28]
        STR      R1,[R0, #+16]
        STR      R1,[R0, #+20]
        STR      R1,[R0, #+8]
        STR      R1,[R0, #+12]
        STR      R1,[R0, #+0]
        STR      R1,[R0, #+4]
        MOVS     R1,#+1
        STR      R1,[R0, #+32]
        LSLS     R1,R1,#+8
        STR      R1,[R0, #+32]
        BX       LR               ;; return

