        LDR      R0,[R7, #+0]
        MOVS     R5,#+1
        LSLS     R5,R5,R4
        MOVS     R4,R5
        MOVS     R5,#+146
        LSLS     R5,R5,#+1        ;; #+292
        ADDS     R5,R2,R5
        STR      R4,[R5, #+0]
        STR      R6,[R7, #+0]
        LDR      R6,[SP, #+0]
        ORRS     R6,R6,R3
        STR      R6,[R2, R1]
        STR      R4,[R5, #+4]
        POP      {R3-R7}
        BX       LR               ;; return

