    413          /****************************************************/
    414          /*  Charactor store to Test display buffer(DPbuf[]) */
    415          /* b0-11: ASCII code                                */
    416          /* b12-15: Charactor attribute                      */
    417          /* 0: 8x6 ASCII FONT                                */
    418          /* 1: 16x8 ASCII FONT                               */
    419          /****************************************************/
    420          char CodeOdd, dpsize;

   \                                 In segment CODE, align 4, keep-with-next
    421          void putchar_dp(unsigned short code)
    422          {
   \                     putchar_dp:
   \   00000000   F1B5               PUSH     {R0,R4-R7,LR}
   \   00000002   0400               MOVS     R4,R0
   \   00000004   ....               LDR      R5,??DataTable35  ;; DPcode
   \   00000006   0120               MOVS     R0,#+1
   \   00000008   A870               STRB     R0,[R5, #+2]
    423            DpUpdate = 1;
    424            if (code == '\r')  //0x0D 
   \   0000000A   0020               MOVS     R0,#+0
   \   0000000C   0D2C               CMP      R4,#+13
   \   0000000E   03D1               BNE      ??putchar_dp_0
    425            {
    426              //sOldCode = 0;
    427              CodeOdd = 0;
   \   00000010   E872               STRB     R0,[R5, #+11]
    428              LCD_carrige_return();
   \   00000012   ........           BL       LCD_carrige_return
    429            }
    430            else if (code == '\n') 
    431            {
    432              //sOldCode = 0;
    433              CodeOdd = 0;
    434              LCD_line_feed();
    435            }
    436            else if (code < 0x20)		// control code 는 표시하지 않음
    437            {
    438              //sOldCode = 0;
    439              CodeOdd = 0;
    440            }
    441            else if (code == ' ')	// 스페이스 처리		 
    442            {
    443              // DumpDisplay 이면 첫 스페이스를 무시
    444              //sOldCode = 0;
    445              CodeOdd = 0;
    446              dpsize = display_size();
    447              if ((!DumpDisplay)|(code != 0x20)|((sCurPos % dpsize)!= 0)) 
    448                cursor_move_right();
    449            }   
    450            else if ((code < 0xA0)|(FontStyle != 2))
    451            { 
    452              //sOldCode = 0;
    453              CodeOdd = 0;
    454              sDPbuf[sDPstart + sCurPos] = code;
    455              cursor_move_right();
    456            }
    457            // 한글모드이고 code가 한글 영역인 경우
    458            else if ((FontStyle == 2)&(code >= 0xA0))
    459            {
    460              if (CodeOdd == 0) 
    461              {
    462                // 한글전각/영문반각 표시모드일때 
    463                // 라인의 남은 칸이 반각 한칸뿐이면  스페이스를 삽입
    464                if ((sCurPos % 15) == 14) 
    465                {
    466          	sDPbuf[sDPstart + sCurPos] = 0x20;
    467          	cursor_move_right();
    468                }
    469                CodeOdd = 1;
    470                sDPbuf[sDPstart + sCurPos] = code;
    471                cursor_move_right();
    472              }
    473              else 
    474              {
    475                CodeOdd = 0;
    476                sDPbuf[sDPstart + sCurPos] = code;
    477                //HanBuf[HanIndex++] = code;
    478                cursor_move_right();
    479              }
    480            }
    481          }
