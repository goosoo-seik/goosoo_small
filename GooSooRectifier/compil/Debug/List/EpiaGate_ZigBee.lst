   1484            {
   1485              putchar0(*Ptr);       printf("%02X ", *Ptr);
   1486              csum += *Ptr;
   1487              Ptr++;
   1488            }
   1489            putchar0(csum);         printf("%02X ", csum);
   1490            putchar0(ETX_ZB);       printf("%02X ",ETX_ZB);
   1491          }
   1492          
   1493          #define APP_MAX_DATA_SIZE	(64)
