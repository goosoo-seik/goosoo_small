     19          const unsigned char ATCRM129[] = {"AT+CRM=129\r"}; 
     20          const unsigned char ATS01[] = {"ATS0=1\r"}; 
     21          //const unsigned char END_CODE[] = {"^]+++^[\n"};
     22          const unsigned char END_CODE[] = {0x1D, 0x2B, 0x2B, 0x2B, 0x1B, 0x0D};
     23          const unsigned char ATE0[] = {"ATE0\r"};
     24          const unsigned char SEVER_CALL[] = {"ATDT01071068791\r"};
     25          const unsigned char PK_SAMPLE[] = {"0001 0002 2007/07/04 2207 234 1810\r"};
