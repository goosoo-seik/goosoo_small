//   11 /*****************************************************************************/
//   12 /*          FLASH MEMORY MAPPING DEFINITIONS FOR AT91SAM7X256                */
//   13 /*****************************************************************************/
//   14 /*
//   15 AT91C_IFLASH              	EQU (0x00100000) ;- Internal FLASH base address
//   16 AT91C_IFLASH_SIZE         	EQU (0x00040000) ;- Internal FLASH size in byte (256 Kbytes)
//   17 AT91C_IFLASH_PAGE_SIZE    	EQU (256) 	;- Internal FLASH Page Size: 256 bytes
//   18 AT91C_IFLASH_LOCK_REGION_SIZE	EQU (16384) 	;- Internal FLASH Lock Region Size: 16 Kbytes
//   19 AT91C_IFLASH_NB_OF_PAGES  	EQU (1024) 	;- Internal FLASH Number of Pages: 1024 bytes
//   20 AT91C_IFLASH_NB_OF_LOCK_BITS 	EQU (16) 	;- Internal FLASH Number of Lock Bits: 16 bytes
//   21 
//   22 typedef struct _AT91S_MC {
//   23 	AT91_REG	 MC_RCR; 	// MC Remap Control Register
//   24 	AT91_REG	 MC_ASR; 	// MC Abort Status Register
//   25 	AT91_REG	 MC_AASR; 	// MC Abort Address Status Register
//   26 	AT91_REG	 Reserved0[21]; 	// 
//   27 	AT91_REG	 MC_FMR; 	// MC Flash Mode Register
//   28 	AT91_REG	 MC_FCR; 	// MC Flash Command Register
//   29 	AT91_REG	 MC_FSR; 	// MC Flash Status Register
//   30 } AT91S_MC, *AT91PS_MC;
//   31 */
//   32 
//   33 #define	SAMPLE_ID	0xAA55
//   34 #define	SAMPLE_PER_RECORD	40
//   35 
//   36 #define	FLASH_START_ADD		0x00100000
//   37 #define	FDATA_START_ADD		0x00120000
//   38 #define	FLASH_PARAMETER_ADD	0x0011FF00
//   39 
//   40 #define	FDATA_START_PAGE	0x0200
//   41 #define	FDATA_SIZE		0x00020000
//   42 #define	EFC_KEY			0x5A << 24
//   43 #define	EFC_WAIT		4 << 8
//   44 
//   45 // Flash Mode
//   46 #define	EFC_FRDY	1		// Flash ready int enable
//   47 #define	EFC_LOCKE_IE	4		// Flash lock error int enable
//   48 #define	EFC_PROGE_IE	8		// Programming error int enable
//   49 #define	EFC_NO_ERASE	0x80		// No erase before programming
//   50 #define	EFC_FLASH_WATE	0x03 << 8       // Flash wait state(0-3)
//   51 #define	EFC_CYCLE_NO	72 << 16	// Flash uSec cycle no
//   52 #define	EFC_MODE_DEFAULT	EFC_CYCLE_NO|EFC_FLASH_WATE	
//   53 
//   54 // Flash Command
//   55 #define	EFC_WRITE_PAGE	1		// Write Page
//   56 #define	EFC_SET_LOCK    2               // Set lock bit
//   57 #define	EFC_WRITE_LOCK  3               // Write page & lock 
//   58 #define	EFC_CLEAR_LOCK  4               // Clear lock bit
//   59 #define	EFC_ERASE_ALL   8               // Erase all
//   60 #define	EFC_SET_NVM     0x0B            // Set GP NVM bit
//   61 #define	EFC_CLEAR_NVM	0x0D		// Clear GP NVM bit
//   62 #define	EFC_SECURITY    0x0F            // Set Security bit
//   63 
//   64 //Flash Status
//   65 #define	EFC_READY	0x00000001	// Flash ready
//   66 #define	EFC_LOCK_ERR	0x00000002      // Lock error
//   67 #define	EFC_PROG_ERR    0x00000004      // Programming error
//   68 #define	EFC_SECU_STS	0x00000008      // Security bit status
//   69 #define	EFC_GPNVM0	0x00000100      // GP NVM bit 0
//   70 #define	EFC_GPNVM1	0x00000200      // GP NVM bit 1
//   71 #define	EFC_GPNVM2	0x00000400      // GP NVM bit 2
//   72 #define	EFC_LOCK	0x00010000      // Lock region(x) lock status
//   73 
//   74 #define	FLASH_MAIN	10
//   75 #define	FLASH_ERASE	100
//   76 #define	FLASH_READ   	200
//   77 #define	FLASH_WRITE	300
//   78 #define	FLASH_LOCK      400
//   79 #define	FLASH_UNLOCK    500
