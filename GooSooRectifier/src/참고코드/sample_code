    end = start + 11;
   }
   else if (LcdBlock == 1) 
   {
    start = (LcdLine << 5) + 11;
    end = start + 11;
   }
   else 
   {
    start = (LcdLine << 5) + 21;
    end = start + 10;
   };
  
  for (add = start; add < end; add++) 
    putchar_lcd(DPbuf[sDPstart + add], add);
}

