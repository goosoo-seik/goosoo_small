//   14 #define	ADE_WAVEFORM	0x01	// R 24 waveform Register
//   15 #define	ADE_AENERGY     0x02    // R 24 Active Energy Register
//   16 #define	ADE_RAENERGY    0x03    // R 24 Same as AENERGY(read reset)
//   17 #define	ADE_LAENERGY    0x04    // R 24 Line Accumulation Active Energy Register
//   18 #define	ADE_VAENERGY    0x05    // R 24 Apparent Energy Register. 
//   19 #define	ADE_RVAENERGY   0x06    // R 24 Same as VAENERGY(read reset)
//   20 #define	ADE_LVAENERGY   0x07    // R 24 Line Accumulation Apparent Energy Register.
//   21 #define	ADE_LVARENERGY	0x08    // R 24 Line Accumulation Reactive Energy Register.
//   22 #define	ADE_MODE	0x09    //RW 16 Mode Register
//   23 
//   24 #define	ADE_IRQEN	0x0A    //RW 16 Interrupt Enable Register.
//   25 #define	ADE_STATUS      0x0B    // R 16 Interrupt Status Register.
//   26 #define	ADE_RSTSSTATUS  0x0C    // R 16 Same as STATUS(Read only)
//   27 
//   28 #define	ADE_CH1OS       0x0D    //RW  8 Channel 1 Offset Adjust(b6:not use)
//   29 #define	ADE_CH2OS       0x0E    //RW  8 Channel 2 Offset Adjust(b5,6: not use)
//   30 #define	ADE_GAIN        0x0F    //RW  8 PGA Gain adjust.
//   31 #define	ADE_PHCAL       0x10    //RW  6 Phase Calibration Register.
//   32 #define	ADE_APOS        0x11    //RW 16 Active Power Offset Correction.
//   33 #define	ADE_WGAIN       0x12    //RW 12 Power Gain Adjust
//   34 #define	ADE_WDIV        0x13    //RW  8 Active Energy Divider Register
//   35 #define	ADE_CFNUM       0x14    //RW 12 CF Frequency Divider Numerator Register
//   36 #define	ADE_CFDEN       0x15    //RW 12 CF Frequency Divider Denomiantor Register
//   37 #define	ADE_IRMS        0x16    // R 24 Channel 1 RMS Value(Current Channel)
//   38 #define	ADE_VRMS        0x17    // R 24 Channel 2 RMS Value(Voltage Channel)
//   39 #define	ADE_IRMSOS      0x18    //RW 12 Channel 1 RMS Offset Correction Register                   Channel
//   40 #define	ADE_VRMSOS      0x19    //RW 12 Channel 2 RMS Offset Correction Register
//   41 #define	ADE_VAGAIN      0x1A    //RW 12 Apparent Gain Register
//   42 #define	ADE_VADIV       0x1B    //RW  8 Apparent Energy Divider Register
//   43 #define	ADE_LINECYC     0x1C    //RW 16 Line Cycle Energy Accumulation Mode Line-Cycle Register
//   44 #define	ADE_ZXTOUT      0x1D    //RW 12 Zero-Crossing Timeout.
//   45 #define	ADE_SAGCYC      0x1E    //RW  8 Sag Line Cycle Register.
//   46 #define	ADE_SAGLVL      0x1F    //RW  8 SagVoltage Level.
//   47 #define	ADE_IPKLVL      0x20    //RW  8 Channel 1 Peak Level Threshold(Current Channel)
//   48 #define	ADE_VPKLVL      0x21    //RW  8 Channel 1 Peak Level Threshold(Voltage Channel)
//   49 #define	ADE_IPEAK       0x22    // R 24 Channel 1 Peak Register
//   50 #define	ADE_RSTIPEAK    0x23    // R 24 Same as IPEAK(Read Reset)
//   51 #define	ADE_VPEAK	0x24    // R 24 Channel 2 Peak Register
//   52 #define	ADE_RSTVPEAK	0x25    // R 24 Same as VPEAK(Read Reset)
//   53 #define	ADE_TEMP	0x26    // R  8 Temperature Register/
//   54 #define	ADE_PERIOD	0x27    // R 16 Period of the Channel 2(Voltage Channel)                                   
//   55 #define	ADE_TMODE	0x3D    //RW  8 Test Mode Register.
