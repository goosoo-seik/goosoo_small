        ADDS     R0,R0,#+1
        STRH     R0,[R5, #+16]
//  708     }
//  709     
//  710     if (ErrUsart != 0) 
??ZCM_rsp_receive_4:
        LDR      R0,??DataTable27  ;; ErrUsart
        LDRB     R1,[R0, #+0]
        CMP      R1,#+0
        BEQ      ??ZCM_rsp_receive_5
//  711     {
//  712       ZBerr++;
