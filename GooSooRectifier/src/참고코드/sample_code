// 1 byte data write to LCD module block 1
void LCD_data_write1(BYTE d)
{
  //LCD_CTRL = 0x18;      // data select
  LCD_DATA = d;		// data out
  LCD_CTRL = 0x19;      // LCD_A0 | LCD_E1;
  LCD_CTRL = 0x18;
}

