    232          /********************************/
    233          /* LCD Data IN/OUT Functionc    */
    234          /* For DataImage PG12864RU      */
    235          /* 미완성 code(Lee Y K)         */
    236          /********************************/
    237          #ifdef PG12864RU
    238          // 1 byte write to LCD module master
    239          void LCD_write1(BYTE data)
    240          {
    241            data &= 0xFF;
    242            pio_set( PIOB, data );            // data out
    243            pio_clear( PIOB, data ^ 0xFF );   // data out
    244            delay_lcd(3);
    245            pio_clear( PIOB, LCD_EN);
    246            delay_lcd(3);
    247            pio_set( PIOB, LCD_EN);
    248          }
    249          
    250          // 1 byte write to LCD module slave
    251          void LCD_write2(BYTE data)
    252          {
    253            data &= 0xFF;
    254            pio_set( PIOB, data );            // data out
    255            pio_clear( PIOB, data ^ 0xFF );   // data out
    256            delay_lcd(3);
    257            pio_clear( PIOB, LCD_EN);
    258            delay_lcd(3);
    259            pio_set( PIOB, LCD_EN);
    260          }
    261          
    262          // 1 byte CMD write to LCD module master
    263          void LCD_cmd_write1(BYTE cmd)
    264          {
    265            pio_clear( PIOB, LCD_EN);
    266            pio_set( PIOB, LCD_CS2);
    267            pio_clear( PIOB, LCD_CS1|LCD_A0|LCD_RW);
    268            delay_lcd(2);
    269            pio_set( PIOB, LCD_EN);
    270            LCD_write1(cmd);
    271            //pio_set( PIOB, LCD_A0);
    272          }
    273          
    274          // 1 byte CMD write to LCD module slave
    275          void LCD_cmd_write2(BYTE cmd)
    276          {
    277            pio_clear( PIOB, LCD_EN);
    278            pio_set( PIOB, LCD_CS1);
    279            pio_clear( PIOB, LCD_CS2|LCD_A0|LCD_RW|LCD_EN);
    280            delay_lcd(2);
    281            pio_set( PIOB, LCD_EN);
    282            LCD_write2(cmd);
    283            //pio_set( PIOB, LCD_A0);
    284          }
    285          
    286          // 1 byte data write to LCD module master
    287          void LCD_data_write1(unsigned char data)
    288          {
    289            pio_clear( PIOB, LCD_EN);
    290            pio_set( PIOB, LCD_CS2|LCD_A0);
    291            pio_clear( PIOB, LCD_CS1|LCD_RW);
    292            delay_lcd(2);
    293            pio_set( PIOB, LCD_EN);
    294            LCD_write1(data);
    295          }
    296          
    297          // 1 byte data write to LCD module slave
    298          void LCD_data_write2(unsigned char data)
    299          {
    300            pio_clear( PIOB, LCD_EN);
    301            pio_set( PIOB, LCD_CS1|LCD_A0);
    302            pio_clear( PIOB, LCD_CS2|LCD_RW);
    303            delay_lcd(2);
    304            pio_set( PIOB, LCD_EN);
    305            LCD_write2(data);
    306          }
    307          
    308          void LCD_test(char page)
    309          {
    310            unsigned char lp, data;
    311            data = 0x80;
    312            
    313            page &= 16;
    314            if (page < 8)
    315             {
    316               LCD_cmd_write1(LCD_DP_START);
    317               LCD_cmd_write1(LCD_PAGE_ADD+page);
    318               LCD_cmd_write1(LCD_COL_ADD);
    319               for (lp = 0; lp < 64; lp++) LCD_data_write1(data++);
    320             }
    321             else 
    322             {
    323               page &= 7;
    324               LCD_cmd_write2(LCD_DP_START);
    325               LCD_cmd_write2(LCD_PAGE_ADD+page);
    326               LCD_cmd_write2(LCD_COL_ADD);
    327               for (lp = 0; lp < 64; lp++) LCD_data_write2(data++);
    328             }
    329          }
    330          
    331          #endif
