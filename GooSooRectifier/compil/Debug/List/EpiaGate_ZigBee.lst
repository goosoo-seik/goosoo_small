   1448            char  *Ptr = (char*)&TxSerialPkt;
   1449            Ptr += 2;
   1450            //->PKT;
   1451            printf("\nPtr: %x", Ptr);
   1452            printf("\n*Ptr: %x", *Ptr);
   1453            printf("\n&TxSerialPkt: %x", &TxSerialPkt);
   1454            printf("\npOutPkt: %x", pOutPkt);
   1455           // printf("\n*pOutPkt: %x", *pOutPkt);
   1456            
   1457            i = sizeof(csum);
   1458          //  i = malloc(csum);
   1459            //P_NWK.NLME_NETWORK_FORMATION_req.ScanChannels = (UINT32)0x01 << 11;
   1460            P_NWK.NLME_NETWORK_FORMATION_req.ScanDuration = 2;
   1461            P_NWK.NLME_NETWORK_FORMATION_req.BeaconOrder = 0x0F;
   1462            P_NWK.NLME_NETWORK_FORMATION_req.SuperframeOrder = 0x0F;
   1463            //P_NWK.NLME_NETWORK_FORMATION_req.PANId = 0x1234;
   1464            P_NWK.NLME_NETWORK_FORMATION_req.BatteryLifeExtension = 0;
   1465            
   1466            pOutPkt->PKT.layer = NWK_LAYER;               // 0x20
   1467            pOutPkt->PKT.Opcode = NLME_NETWORK_FORMATION; // 0x12
   1468            pOutPkt->PKT.Type = REQUEST;                  // 0x10
   1469            pOutPkt->PKT.Size = sizeof(NLME_NETWORK_FORMATION_REQ);
   1470            memcpy(pOutPkt->PKT.Arguments, &P_NWK, pOutPkt->PKT.Size);
   1471            
   1472            pOutPkt->LEN = pOutPkt->PKT.Size + 4;
   1473            
   1474            printf("\n&pOutPkt->PKT.Arguments: %x ", &pOutPkt->PKT.Arguments);
   1475            printf("\n&P_NWK: %02X", &P_NWK);
   1476            printf("\npOutPkt->PKT.Size: %02X", pOutPkt->PKT.Size);
   1477            pOutPkt->LEN = pOutPkt->PKT.Size + 4;
   1478            //
   1479            // Serial Write
   1480            //
   1481            putchar0(STX_ZB);       printf("\n%02X ",STX_ZB);
   1482            putchar0(pOutPkt->LEN); printf("%02X ", pOutPkt->LEN);
