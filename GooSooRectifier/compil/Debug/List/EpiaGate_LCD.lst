   1097          
   1098          void GM12321_LCD_init(char page, char start, char col, char ms)
   1099          {
   1100            page &= 3;
   1101            start &= 0x1F;
   1102            ms &= 1;
   1103            if (col > 72) col = 72;
   1104            LcdCol = 0; 
   1105            LcdRow = 0; 
   1106            LCD_hard_reset();
   1107          //  LCD_byte_write(LCD_SOFT_RST, 1, 0);
   1108            LCD_byte_write(LCD_ON, 1, ms);
   1109            LCD_byte_write(LCD_ADC_CW, 1, ms);
   1110            LCD_byte_write(LCD_DRV_NORMAL, 1, ms);
   1111            LCD_byte_write(LCD_DUTY32, 1, ms);
   1112          //LCD_byte_write(LCD_MODI_OFF, 1, ms);
   1113            LCD_byte_write(LCD_PAGE_ADD+page, 1, ms);
   1114            LCD_byte_write(LCD_DP_START+start, 1, ms);
   1115            LCD_byte_write(LCD_COL_ADD+col, 1, ms);
   1116            PowerOnMsg_display();
   1117          }
   1118          
   1119          void LCD_test0(char size, char ms)
   1120          {
   1121           char loop, data;
   1122           data = 0x80;
   1123           ms &= 1;
   1124           if (!ms) LCD_cmd_write1(0); else LCD_cmd_write2(0);
   1125            for (loop = 0; loop < size; loop++) {
   1126             if (!ms) LCD_data_write1(data); else  LCD_data_write2(data);
   1127             data = data >> 1;
   1128             if (!data) data = 0x80;
   1129            }
   1130          }
