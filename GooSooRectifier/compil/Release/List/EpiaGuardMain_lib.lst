    183          /********************************************************************
    184          *  MakeCrc16() : make to cyclic redendancy check 16 
    185          * *ptr로 지정된 번지부터 n byte 의 CRC를 계산해 16bit CRC를 리턴
    186          ********************************************************************/

   \                                 In segment CODE, align 4, keep-with-next
    187          unsigned short	MakeCrc16(unsigned char	*ptr, unsigned short	n)
    188          {
   \                     MakeCrc16:
   \   00000000   30B5               PUSH     {R4,R5,LR}
   \   00000002   0200               MOVS     R2,R0
    189          	unsigned short	crc = 0xffff;
   \   00000004   ....               LDR      R0,??DataTable3  ;; 0xffff
    190          	unsigned short	uitmp;
    191          	unsigned char	uctmp;
    192          
    193          	for(uitmp = 0;uitmp < n;uitmp++)
   \   00000006   0023               MOVS     R3,#+0
   \   00000008   05E0               B        ??MakeCrc16_0
    194          	{
    195          		crc = (crc & 0xff00) | (crc ^ (unsigned short)(ptr[uitmp] & 0xff));
    196          		for(uctmp = 0;uctmp < 8;uctmp++)
    197          		{
    198          			if(crc & 0x0001)
    199          				crc = (crc >> 1) ^ 0xa001;
    200          			else
    201          				crc >>= 1;
   \                     ??MakeCrc16_1:
   \   0000000A   2000               MOVS     R0,R4
   \                     ??MakeCrc16_2:
   \   0000000C   6D1E               SUBS     R5,R5,#+1
   \   0000000E   0DD1               BNE      ??MakeCrc16_3
   \   00000010   5B1C               ADDS     R3,R3,#+1
   \   00000012   1B04               LSLS     R3,R3,#+16
   \   00000014   1B0C               LSRS     R3,R3,#+16
   \                     ??MakeCrc16_0:
   \   00000016   8B42               CMP      R3,R1
   \   00000018   0FD2               BCS      ??MakeCrc16_4
   \   0000001A   FF25               MOVS     R5,#+255
   \   0000001C   2D02               LSLS     R5,R5,#+8        ;; #+65280
   \   0000001E   0540               ANDS     R5,R5,R0
   \   00000020   D45C               LDRB     R4,[R2, R3]
   \   00000022   4440               EORS     R4,R4,R0
   \   00000024   2C43               ORRS     R4,R4,R5
   \   00000026   2004               LSLS     R0,R4,#+16
   \   00000028   000C               LSRS     R0,R0,#+16
   \   0000002A   0825               MOVS     R5,#+8
   \                     ??MakeCrc16_3:
   \   0000002C   0404               LSLS     R4,R0,#+16
   \   0000002E   640C               LSRS     R4,R4,#+17
   \   00000030   C007               LSLS     R0,R0,#+31
   \   00000032   EAD5               BPL      ??MakeCrc16_1
   \   00000034   0248               LDR      R0,??MakeCrc16_5  ;; 0xa001
   \   00000036   6040               EORS     R0,R0,R4
   \   00000038   E8E7               B        ??MakeCrc16_2
    202          		}
    203          	}
    204          	return(crc);
   \                     ??MakeCrc16_4:
   \   0000003A   0004               LSLS     R0,R0,#+16
   \   0000003C   000C               LSRS     R0,R0,#+16
   \   0000003E   ....               B.N      ?Subroutine40
   \                     ??MakeCrc16_5:
   \   00000040   01A00000           DC32     0xa001
    205          }

