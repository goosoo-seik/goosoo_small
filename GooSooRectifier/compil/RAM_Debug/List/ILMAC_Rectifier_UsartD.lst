     35          //*----------------------------------------------------------------------------
     36          //* \fn    AT91F_DBGU_SetBaudrate
     37          //* \brief Set the baudrate according to the CPU clock
     38          //*----------------------------------------------------------------------------
     39          __inline void AT91F_DBGU_SetBaudrate (
     40                  AT91PS_DBGU pUSART,
     41          	unsigned int speed)     // \arg UART baudrate
     42          {
     43            unsigned int baud_value;
     44                  baud_value = (AT91B_MCK/(speed * 16));
     45          	//* Define the baud rate divisor register
     46          	pUSART->DBGU_BRGR =  baud_value;
     47          }
     48          
     49          //*----------------------------------------------------------------------------
     50          //* \fn    AT91F_DBGU_GetChar
     51          //* \brief Receive a character,does not check if a character is available
     52          //*----------------------------------------------------------------------------
     53          __inline int AT91F_DBGU_GetChar (
     54          	const AT91PS_DBGU pUSART)
     55          {
     56              return((pUSART->DBGU_RHR) & 0x1FF);
     57          }
     58          
     59          //*----------------------------------------------------------------------------
     60          //* \fn    AT91F_DBGU_PutChar
     61          //* \brief Send a character,does not check if ready to send
     62          //*----------------------------------------------------------------------------
     63          __inline void AT91F_DBGU_PutChar (
     64          	AT91PS_DBGU pUSART,
     65          	int character )
     66          {
     67              pUSART->DBGU_THR = (character & 0x1FF);
     68          }
