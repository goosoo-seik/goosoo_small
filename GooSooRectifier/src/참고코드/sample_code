// 1개의 6x7 font image를 bLCDbuf에 로드
void LCD_font6x7_load(BYTE c, BYTE curpos)
{
  short pos, pos_h, line;
  unsigned char dpsize, lp, mask;
  //const unsigned char* ptr = 0;
  
  dpsize = LCD_LINE_SIZE / 6;
  line = curpos / dpsize; 
  
  pos = (BYTE)(curpos % dpsize) * 6; 
  pos = line * LCD_LINE_SIZE + pos;
  pos_h = pos - (line * LCD_LINE_SIZE);
  
  // 남은 LCD width가 font size 보다 작으면 다음 line의 처음으로 위치 변경
  if (pos_h > (LCD_LINE_SIZE - 6)) 
  {
    if (++line > 3) line = 0;
    pos = line * LCD_LINE_SIZE;
  }
  
  // LCD buffer에 1 font image를 copy
  if ((!Blink)|(sCurPos != curpos))
    for (lp = 0; lp < 6; lp++) 
     LCDbuf[pos++] = ASCII_FONT6x7[c][lp];
   else 
    for (lp = 0; lp < 6; lp++) 
     LCDbuf[pos++] = ASCII_FONT6x7[c][lp] ^ 0xFF;

  //ptr = ASCII_FONT6x7[c][0];
  //for (lp = 0; lp < 6; lp++) LCDbuf[pos++] = (*ptr++) ^ mask;
  //sLCDpos = pos;
}

// 1개의 8x16 font image를 bLCDbuf에 로드
void LCD_font8x16_load(BYTE c, BYTE curpos)
{
  short pos, pos_h, line;
  unsigned char dpsize, lp, mask;
  
  dpsize = LCD_LINE_SIZE >> 3;
  line = curpos / dpsize;
 
  pos = (BYTE)(curpos % dpsize) << 3;
  pos = line * LCD_LINE_SIZE * 2 + pos;
  pos_h = pos - (line * LCD_LINE_SIZE * 2);
  
  // 남은 LCD width가 font size 보다 작으면 다음 line의 처음으로 위치 변경
  if (pos_h > (LCD_LINE_SIZE - 8)) 
  {
    if (++line > 1) line = 0;
    pos = line * LCD_LINE_SIZE * 2;
  }

  // LCD buffer에 1 font image를 copy
  if ((!Blink)|(sCurPos != curpos))
   {
    for (lp = 0; lp < 8; lp++) 
     LCDbuf[pos++] = ASCII_FONT8x16[c][lp];
    pos = pos + LCD_LINE_SIZE - 8;
    for (lp = 8; lp < 16; lp++) 
     LCDbuf[pos++] = ASCII_FONT8x16[c][lp];
   }
   else
   { 
    for (lp = 0; lp < 8; lp++) 
     LCDbuf[pos++] = ASCII_FONT8x16[c][lp] ^ 0xFF;
    pos = pos + LCD_LINE_SIZE - 8;
    for (lp = 8; lp < 16; lp++) 
     LCDbuf[pos++] = ASCII_FONT8x16[c][lp] ^ 0xFF;
   }
}
