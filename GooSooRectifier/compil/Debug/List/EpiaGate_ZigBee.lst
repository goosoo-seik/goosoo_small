    329          /*    STX, ETX, SUM check     */
    330          /******************************/

   \                                 In segment CODE, align 4, keep-with-next
    331          char packet_verify(char *Ptr)
    332          { 
   \                     packet_verify:
   \   00000000   70B5               PUSH     {R4-R6,LR}
   \   00000002   0100               MOVS     R1,R0
    333            char no, size; 
    334            char err = NO_ERR;
   \   00000004   0023               MOVS     R3,#+0
   \   00000006   0020               MOVS     R0,#+0
    335            char sum = 0;
   \   00000008   0200               MOVS     R2,R0
    336            
    337            if (*Ptr != STX_ZB) err = STX_ERR;
   \   0000000A   0C78               LDRB     R4,[R1, #+0]
   \   0000000C   AA2C               CMP      R4,#+170
   \   0000000E   00D0               BEQ      ??packet_verify_0
   \   00000010   0120               MOVS     R0,#+1
    338            Ptr++;
   \                     ??packet_verify_0:
   \   00000012   491C               ADDS     R1,R1,#+1
    339            size = *Ptr;
   \   00000014   0C78               LDRB     R4,[R1, #+0]
    340            if (size >= 128) err = LEN_ERR;
   \   00000016   802C               CMP      R4,#+128
   \   00000018   00D3               BCC      ??packet_verify_1
   \   0000001A   0420               MOVS     R0,#+4
    341            Ptr++;
   \                     ??packet_verify_1:
   \   0000001C   491C               ADDS     R1,R1,#+1
    342            for (no = 0; no < size; no++) sum += *Ptr++;
   \   0000001E   2600               MOVS     R6,R4
   \   00000020   07E0               B        ??packet_verify_2
   \                     ??packet_verify_3:
   \   00000022   0D78               LDRB     R5,[R1, #+0]
   \   00000024   5219               ADDS     R2,R2,R5
   \   00000026   1206               LSLS     R2,R2,#+24
   \   00000028   120E               LSRS     R2,R2,#+24
   \   0000002A   491C               ADDS     R1,R1,#+1
   \   0000002C   5B1C               ADDS     R3,R3,#+1
   \   0000002E   1B06               LSLS     R3,R3,#+24
   \   00000030   1B0E               LSRS     R3,R3,#+24
   \                     ??packet_verify_2:
   \   00000032   A342               CMP      R3,R4
   \   00000034   F5D3               BCC      ??packet_verify_3
    343            if (*Ptr != sum) err = SUM_ERR;
   \   00000036   0B78               LDRB     R3,[R1, #+0]
   \   00000038   9342               CMP      R3,R2
   \   0000003A   01D0               BEQ      ??packet_verify_4
   \   0000003C   0320               MOVS     R0,#+3
   \   0000003E   03E0               B        ??packet_verify_5
    344             else if (*++Ptr != ETX_ZB) err = ETX_ERR; 
   \                     ??packet_verify_4:
   \   00000040   4978               LDRB     R1,[R1, #+1]
   \   00000042   5529               CMP      R1,#+85
   \   00000044   00D0               BEQ      ??packet_verify_5
   \   00000046   0220               MOVS     R0,#+2
    345            //printf("\nErr:%1d size:%2x sum:%2x ptr:%2x", err, size, sum, *Ptr);  
    346            return err;
   \                     ??packet_verify_5:
   \   00000048   70BC               POP      {R4-R6}
   \   0000004A   02BC               POP      {R1}
   \   0000004C   0847               BX       R1               ;; return
    347          }
