    640          /*******************************/
    641          /* ZCM debug print             */
    642          /* ZigBee Packet : HEX print   */
    643          /* Other message : ASCII print */
    644          /*******************************/

   \                                 In segment DATA_Z, align 1, align-sorted
    645          char ZCMdpMode;
   \                     ZCMdpMode:
   \   00000000                      DS8 1
    646          char PacketLength;
   \                     PacketLength:
   \   00000001                      DS8 1

   \                                 In segment CODE, align 4, keep-with-next
    647          void ZCM_debug_print(char c)
    648          {
   \                     ZCM_debug_print:
   \   00000000   70B5               PUSH     {R4-R6,LR}
    649            switch (ZCMdpMode)  
   \   00000002   0100               MOVS     R1,R0
   \   00000004   ....               LDR      R4,??DataTable23  ;; `?<Constant "\\nED>Rx:%02dbyte Err:%02d">`
   \   00000006   0022               MOVS     R2,#+0
   \   00000008   174D               LDR      R5,??ZCM_debug_print_0  ;; ZCMdpMode
   \   0000000A   2B78               LDRB     R3,[R5, #+0]
   \   0000000C   002B               CMP      R3,#+0
   \   0000000E   04D0               BEQ      ??ZCM_debug_print_1
   \   00000010   012B               CMP      R3,#+1
   \   00000012   12D0               BEQ      ??ZCM_debug_print_2
   \   00000014   022B               CMP      R3,#+2
   \   00000016   19D0               BEQ      ??ZCM_debug_print_3
   \   00000018   24E0               B        ??ZCM_debug_print_4
    650            {
    651              
    652              case 0:     
    653                if (c == 0xAA) 
   \                     ??ZCM_debug_print_1:
   \   0000001A   AA28               CMP      R0,#+170
   \   0000001C   0BD1               BNE      ??ZCM_debug_print_5
    654                {
    655          	ZCMdpMode = 1;
   \   0000001E   0120               MOVS     R0,#+1
   \   00000020   2870               STRB     R0,[R5, #+0]
    656          	printf("\nZCM Packet: ");
   \   00000022   2000               MOVS     R0,R4
   \   00000024   1C30               ADDS     R0,R0,#+28
   \   00000026   ........           _BLF     printf,??printf??rT
    657          	printf("%02X ",c);
   \   0000002A   AA21               MOVS     R1,#+170
   \   0000002C   2C34               ADDS     R4,R4,#+44
   \   0000002E   2000               MOVS     R0,R4
   \                     ??ZCM_debug_print_6:
   \   00000030   ........           _BLF     printf,??printf??rT
   \   00000034   17E0               B        ??ZCM_debug_print_7
    658                } else printf("%c",c);
   \                     ??ZCM_debug_print_5:
   \   00000036   ....               ADR      R0,??DataTable24  ;; "%c"
   \   00000038   FAE7               B.N      ??ZCM_debug_print_6
    659                return;
    660                
    661              case 1:
    662                PacketLength = c + 1;
   \                     ??ZCM_debug_print_2:
   \   0000003A   401C               ADDS     R0,R0,#+1
