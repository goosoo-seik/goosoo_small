   1155          /********************************************/
   1156          /*  LCD module control Functions            */
   1157          /*  For 128x64 Graphic LCD Module GM123210  */
   1158          /********************************************/
   1159          #ifdef GM123210
   1160          /**********************************************/
   1161          /*  Display Scanning Control                  */
   1162          /*  For 122x32 Graphic LCD Module GM123210    */
   1163          /*  x0: 1 line(1/4 page) LCD font load        */
   1164          /*  x1: skip                                  */
   1165          /*  x2: 1/8 page data transfer to LCD module  */
   1166          /*  x3: skip                                  */
   1167          /*  1 page scan time : 16 x 2 = 32 ms         */
   1168          /*  Page Scan : 1000 / 32 = 31.25 Hz          */
   1169          /* This function must locate in main loop     */ 
   1170          /**********************************************/
   1171          // bDPbuf[]중 1line의 graphic image를 bLCDbuf에 로드
   1172          void LCD_image_load(char line, char image)
   1173          {
   1174            short add, start, end;
   1175            unsigned const char* ptr = 0;
   1176            line &= 0x03;
   1177            start = line * LCD_LINE_SIZE;
   1178            end = start + LCD_LINE_SIZE;
   1179          
   1180            ptr = pImagePtr[image];
   1181            ptr = ptr + start;
   1182            for (add = start; add < end; add++) bLCDbuf[add] = *ptr++;
   1183          }
   1184          
   1185          void LCD_GM12321_scan(void)
   1186          {
   1187            BYTE pos, page, ms, end, lp;
   1188            pos = bLCDpage * PAGE_SIZE;
   1189            end = pos + PAGE_SIZE;
   1190            ms = bLCDpage & 1;
   1191            page = (bLCDpage >> 1) + LCD_PAGE_ADD;
   1192            if (!ms) 
   1193               {
   1194                LCD_cmd_write1(page);
   1195                LCD_cmd_write1(0);
   1196                for (lp = pos; lp < end; lp++) LCD_data_write1(bLCDbuf[lp]);
   1197               }
   1198               else 
   1199                {
   1200                 LCD_cmd_write2(page);
   1201                 LCD_cmd_write2(0);
   1202                 for (lp = pos; lp < end; lp++) LCD_data_write2(bLCDbuf[lp]);
   1203                }
   1204            if (++bLCDpage >= 8) bLCDpage = 0;
   1205          }
   1206          
   1207          void display_scan(void)
   1208          {
   1209            if (CursorUse) cursor_blink_control(); else Blink = 0;
   1210            if (DpScanNo < DP_SCAN_TIME)
   1211            {
   1212              DpScanNo++;
   1213              if ((DpScanNo & 3) > 1) LCD_GM12321_scan();
   1214               else if ((DpScanNo & 3) == 0) 
   1215                if (ImageMode) LCD_image_load(DpScanNo >> 2, ImageNo);
   1216                 else LCD_line_load(DpScanNo >> 2, FontStyle);
   1217            } 
   1218            else 
   1219            {
   1220              if (DpUpdate) DpScanNo = 0;
   1221              if (DpUpdate == 1) DpUpdate++; else DpUpdate = 0;
   1222            }   
   1223          }
   1224          #endif
   1225          
   1226          /********************************************/
   1227          /*  LCD module control Functions            */
   1228          /*  For 128x64 Graphic LCD Module PG12864RU */
   1229          /********************************************/
   1230          #ifdef PG12864RU
   1231          /********************************************/
   1232          /*  Trasnfer video data for LCD scan        */
   1233          /*  For 128x64 Graphic LCD Module PG12864RU */
   1234          /*  Data transfer to LCD module from LCDbuf */
   1235          /*  1/16 page transfer per one execute      */
   1236          /*  Scaning duration = 16 x 2 = 32 ms       */
   1237          /********************************************/ 
   1238          void LCD_PG12864RU_scan(void)
   1239          {
   1240            short pos, lp;
   1241            unsigned char page;
   1242            
   1243            page = (unsigned char)(LCD_PAGE_ADD + LcdLine);  
   1244            
   1245            if (LcdBlock == 0)
   1246             {
   1247                pos = LcdLine * LCD_LINE_SIZE;
   1248                LCD_cmd_write1(page);
   1249                LCD_cmd_write1(LCD_COL_ADD);	        // column = 0
   1250                for (lp = 0; lp < 64; lp++) LCD_data_write1(bLCDbuf[pos++]);
   1251              }
   1252              else if (LcdBlock == 1)
   1253              { 
   1254                 pos = LcdLine * LCD_LINE_SIZE + 64;
   1255                 LCD_cmd_write2(page);
   1256                 LCD_cmd_write2(LCD_COL_ADD);
   1257                 for (lp = 0; lp < 64; lp++) LCD_data_write2(bLCDbuf[pos++]);
   1258               }
   1259          }
   1260          
   1261          /**********************************************/
   1262          /*  Display Scanning Control                  */
   1263          /*  For 128x64 Graphic LCD Module PG12864RU   */
   1264          /*  x0: 1 line(1/4 page) LCD font load        */
   1265          /*  x1: skip                                  */
   1266          /*  x2: 1/8 page data transfer to LCD module  */
   1267          /*  x3: skip                                  */
   1268          /*  1 page scan time : 12 x 4 = 48 ms         */
   1269          /*  Scan per one sec : 1000 / 48 = 20.83 Hz   */
   1270          /* This function must locate in main loop     */ 
   1271          /**********************************************/
   1272          void display_scan(void)
   1273          { 
   1274           //if (CursorUse) cursor_blink_control(); else Blink = 0;
   1275           
   1276            if (DpUpdate)
   1277            {
   1278             DpUpdate = 0;
   1279             LcdBlock = 0;
   1280             LcdLine = 0; 
   1281             DpScanNo = 16;
   1282             LoadIndex = 0;
   1283             //OldCode = 0;
   1284            }  
   1285            else 
   1286            {
   1287             if (DpScanNo > 16)
   1288             {
   1289              DpScanNo--;
   1290              if (ImageMode) LCD_image_scan(ImageNo); 
   1291               else if (!FontStyle) LCD_line_load_6x8();
   1292               else LCD_line_load_8x16();
   1293              }
   1294              //else if (DpScanNo)
   1295              //{
   1296              // DpScanNo--;
   1297              // LCD_PG12864RU_scan();
   1298              //};
   1299              LCD_PG12864RU_scan();
   1300              if (++LcdBlock > 1) 
   1301               {
   1302                LcdBlock = 0;
   1303                if (++LcdLine > 7) LcdLine = 0;
   1304               };
   1305            };    
   1306          }
   1307          #endif
