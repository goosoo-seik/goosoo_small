/**********************************************/
/* 1/12 page의 graphic image를 bLCDbuf에 로드 */
/* For Graphic Image only                     */
/**********************************************/
void LCD_image_scan(char image)
{
  short add, start, end, imsi;
  const unsigned char* ptr = 0;

  if (LcdBlock < 2)
  {
   if (LcdBlock) start = 61; else start = 0;
   start = start + (LcdLine * LCD_LINE_SIZE);
   end = start + 61;
   
   imsi = LcdLine * 122;
   if (LcdBlock) imsi = imsi + 61;
   ptr = pImagePtr[image];
   ptr = ptr + imsi;
  
   for (add = start; add < end; add++) LCDbuf[add] = *ptr++;
  };
}

/********************************************/
/*  Trasnfer video data for LCD scan        */
/*  LCD model: SunLike SCM094 192 x 32 dot  */
/*  Data transfer to LCD module from LCDbuf */
/*  1/12 page transfer per one execute      */
/*  Scaning duration = 12 x 4 = 48 ms       */
/********************************************/ 
void LCD_SCM094_self_scan(void)
{
  short pos, lp;
  unsigned char page;
  
  page = (unsigned char)(LCD_PAGE_ADD + LcdLine);  
  
  if (!LcdBlock)
   {
      pos = LcdLine * LCD_LINE_SIZE;
      LCD_cmd_write1(page);
      LCD_cmd_write1(0);	        // column = 0
      lp = 61;
      while(lp) 
       {
        // 1 byte data write to LCD module block 1 
        LCD_DATA = LCDbuf[pos++];	// data out
        LCD_CTRL = 0x19;                // LCD_A0 | LCD_E1;
        lp--;
        LCD_CTRL = 0x18;
        };
    }
    else if (LcdBlock == 1)
    { 
       pos = LcdLine * LCD_LINE_SIZE + 61;
       LCD_cmd_write2(page);
       LCD_cmd_write2(0);
       lp = 61;
       while(lp) 
       {
        // 1 byte data write to LCD module block 2 
        LCD_DATA = LCDbuf[pos++];	// data out
        LCD_CTRL = 0x1A;                // LCD_A0 | LCD_E2;
        lp--;
        LCD_CTRL = 0x18;         
       };
     }
    else 
    {  
       pos = LcdLine * LCD_LINE_SIZE + 122;
       LCD_cmd_write3(page);
       LCD_cmd_write3(0);
       lp = 70;
       while(lp) 
       {
        // 1 byte data write to LCD module block 3 
        LCD_DATA = LCDbuf[pos++];	// data out
        LCD_CTRL = 0x1C;                // LCD_A0 | LCD_E3;
        lp--;
        LCD_CTRL = 0x18;        
       };
     }
}

void cursor_blink_control(void)
{
  if (++sBlinkTime > BlinkTM) 
  {
    sBlinkTime = 0;
    Blink ^= 1;
    if (!ImageMode) DpUpdate = 1;
  }
}

/**********************************************/
/*  Display Scanning Control                  */
/*  x0: 1 line(1/4 page) LCD font load        */
/*  x1: skip                                  */
/*  x2: 1/8 page data transfer to LCD module  */
/*  x3: skip                                  */
/*  1 page scan time : 12 x 4 = 48 ms         */
/*  Scan per one sec : 1000 / 48 = 20.83 Hz   */
/* This function must locate in main loop     */ 
/**********************************************/
void display_scan(void)
{ 
 if (CursorUse) cursor_blink_control(); else Blink = 0;
 
  if (DpUpdate)
  {
   DpUpdate = 0;
   LcdBlock = 0;
   LcdLine = 0; 
   DpScanNo = 24;
   LoadIndex = 0;
   OldCode = 0;
  }  
  else 
  {
   if (DpScanNo > 12)
   {
    DpScanNo--;
    if (ImageMode) LCD_image_scan(ImageNo); 
     else if (!FontStyle) LCD_line_load_6x8();
     else LCD_line_load_8x16();
    }
    else if (DpScanNo)
    {
     DpScanNo--;
     LCD_SCM094_self_scan();
    };
   
    if (++LcdBlock > 2) 
     {
      LcdBlock = 0;
      if (++LcdLine > 3) LcdLine = 0;
     };
  };    
}
