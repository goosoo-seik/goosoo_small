//   82 char FlashCmd;
//   83 unsigned int uiFlashAdd, uiFlashData;
//   84 unsigned int *pFlashPtr;
//   85 char Result;
//   86 short	sFlashPage, sEraseQty;
//   87 short	sStorePage;

