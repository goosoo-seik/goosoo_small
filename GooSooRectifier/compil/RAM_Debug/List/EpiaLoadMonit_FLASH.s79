// __??Code16?? __code __interwork __atpcs void AT91F_AIC_DisableIt(AT91PS_AIC, unsigned int)
AT91F_AIC_DisableIt:
        MOVS     R2,#+1
        LSLS     R2,R2,R1
        MOVS     R1,#+146
        LSLS     R1,R1,#+1        ;; #+292
        ADDS     R0,R0,R1
        STR      R2,[R0, #+0]
        STR      R2,[R0, #+4]
        BX       LR               ;; return

