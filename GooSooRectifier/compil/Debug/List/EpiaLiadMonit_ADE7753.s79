//   53 #define	ADE_TEMP	0x26    // R  8 Temperature Register/
//   54 #define	ADE_PERIOD	0x27    // R 16 Period of the Channel 2(Voltage Channel)                                   
//   55 #define	ADE_TMODE	0x3D    //RW  8 Test Mode Register.
