     30          
     31          // rx sample: 02 00 44 00 35 00 43 00 35 00 30 00 46 00 30 00 33 00 30 00 30 00 30 00 31 00 30 00 34 00 45 00 30 00 03 00 
     32          char is_data_hex(unsigned char data)
     33          {
     34            char err;
     35            err = 1;
     36            //if ((data >= '0')&(data <= '9')) err = 0;
     37            // else if ((data >= 'A')&(data <= 'F')) err = 0;
     38            if ((data >= 48)&(data <= 57)) err = 0;
     39             else if ((data >= 65)&(data <= 70)) err = 0;
     40            return err;
     41          }
     42            
     43          
     44          short calc_checksum(unsigned char *ptr, char size)
     45          {
     46            short sum;
     47            char lp;
     48            sum = 0;
     49            size = size + 1;
     50            for (lp = 1; lp < size; lp++) 
     51            {
     52              sum = sum + *ptr;
     53              ptr++;
     54            }
     55            return sum;
     56          }
