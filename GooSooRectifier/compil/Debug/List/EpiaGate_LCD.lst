    899          /*
    900          // 오래된 디버깅용 코드?, 찾는 이도 없고..
    901          void LCD_font_load(char font)
    902          {
    903            short lp, end;
    904            sCurPos = 0;
    905            //if (font == 0) width = 6; else width = 8;
    906            if (font == 0) end = 80; else end = 30;
    907            for (lp = 0; lp < end; lp++)
    908            {
    909              putchar_lcd(DPcode, lp, font);
    910              if (++DPcode > 127) DPcode = 0;
    911            }  
    912          }
    913          */
    914          /*
    915          // bDPbuf[]중 커서가 위치한 블럭의 코드에 해당하는 font image를 bLCDbuf에 로드
    916          void LCD_page_load(void)
    917          {
    918            short font, lp, end, code, curpos;
    919            font = sDPbuf[sDPstart] >> 12;
    920            if (font == 0) end = 80; else end = 30;
    921            curpos = sCurPos;
    922            for (lp = 0; lp < end; lp++)
    923            { 
    924              code = sDPbuf[sDPstart + lp];
    925              font = code >> 12;
    926              code &= 0xFF;
    927              putchar_lcd(code, lp);
    928            }
    929            sCurPos = curpos;  
    930          }
    931          */
    932          /*
    933          void LCD_data_write1(BYTE cmd)
    934          {
    935            AT91F_PIO_SetOutput( PIOB, LCD_A0);
    936            LCD_write1(cmd);
    937          }
    938          
    939          void LCD_data_write2(BYTE cmd)
    940          {
    941            AT91F_PIO_SetOutput( PIOB, LCD_A0);
    942            LCD_write2(cmd);
    943          }
    944          
    945          void LCD_byte_write(BYTE data, BYTE sel, BYTE ms)
    946          {
    947            unsigned int pioms, piosel;
    948            //if (++imsi >= 0x50) imsi = 0x30;
    949            //imsi = imsi &0xFF ;
    950            data &= 0xFF;
    951            AT91F_PIO_SetOutput( PIOB, LCD_A0|LCD_CS1|LCD_CS2|LCD_RW|LCD_RST ) ;
    952            if (!ms) pioms = LCD_CS1; else pioms = LCD_CS2;
    953            AT91F_PIO_ClearOutput( PIOB, pioms) ; // E : low
    954            delay_us(10);
    955            if (sel) piosel = LCD_A0|LCD_RW; else piosel = LCD_RW;
    956            AT91F_PIO_ClearOutput( PIOB, piosel ) ;   // RW : low
    957            delay_us(10);
    958            AT91F_PIO_SetOutput( PIOB, pioms );       // E : High
    959            delay_us(10);
    960            AT91F_PIO_SetOutput( PIOB, data );            // data out
    961            AT91F_PIO_ClearOutput( PIOB, data ^ 0xFF );   // data out
    962            delay_us(20);
    963            AT91F_PIO_ClearOutput( PIOB, pioms ) ;    // E : low
    964            delay_us(10);
    965            AT91F_PIO_SetOutput( PIOB, LCD_A0|LCD_CS1|LCD_CS2|LCD_RW|LCD_RST ) ;
    966          }
    967          
    968          // LCD module ON/OFF
    969          void LCD_onoff(BYTE onoff)
    970          {
    971            onoff &= 1;
    972            LCD_byte_write(LCD_ONOFF|onoff, 0, 0);
    973          }
    974          
    975          // LCD module Read? Modify? Wiite ON/OFF
    976          void LCD_modify(BYTE onoff)
    977          {
    978            if (onoff) onoff = LCD_MODIFY; else onoff = LCD_MODI_OFF;
    979            LCD_byte_write(onoff, 1, 0);
    980          }
    981          
    982          // Select LCD duty cycle
    983          // 1: 1/16, 0: 1/32
    984          void LCD_duty_select(BYTE onoff)
    985          {
    986            if (onoff) onoff = LCD_SEL_DUTY; else onoff = LCD_SEL_DUTY + 1;
    987            LCD_byte_write(onoff, 1, 0);
    988          }
    989          
    990          // Select LCD ADC
    991          // 1: CW, 0: CCW
    992          void LCD_ADC_select(BYTE onoff)
    993          {
    994            if (onoff) onoff = LCD_ADC_SEL; else onoff = LCD_ADC_SEL + 1;
    995            LCD_byte_write(onoff, 1, 0);
    996          }
    997          
    998          // Select LCD Static Drive
    999          // 1: Static, 0: Normal
   1000          void LCD_static_drive(BYTE onoff)
   1001          {
   1002            if (onoff) onoff = LCD_STATIC; else onoff = LCD_STATIC + 1;
   1003            LCD_byte_write(onoff, 1, 0);
   1004          }
   1005          
   1006          // LCD RAM line corresponding to top line of display 
   1007          void LCD_start_line(BYTE line)
   1008          {
   1009            line &= 0x1F;
   1010            LCD_byte_write(LCD_DP_START|line, 1, 0);
   1011          }
   1012          
   1013          // LCD module Reset by RESET command
   1014          void LCD_soft_reset(void)
   1015          {
   1016            LCD_byte_write(LCD_SOFT_RST, 1, 0);
   1017          }
   1018          
   1019          // LCD module Set RAM page address in page address register
   1020          void LCD_page_set(BYTE page)
   1021          {
   1022            page &= 0x03;
