    622          	case STD_SET_FEATURE_ZERO:
    623                    //Debug code
    624                    if (USBdebug) printf("->case: STD_SET_FEATURE_ZERO");
    625          		AT91F_USB_SendStall(pUDP);
    626          	    break;
    627          	case STD_SET_FEATURE_INTERFACE:
    628                    //Debug code
    629                    if (USBdebug) printf("->case: STD_SET_FEATURE_INTERFACE");
    630          		AT91F_USB_SendZlp(pUDP);
    631          		break;
    632          	case STD_SET_FEATURE_ENDPOINT:
    633                    //Debug code
    634                    if (USBdebug) printf("->case: STD_SET_FEATURE_ENDPOINT");
    635          		wIndex &= 0x0F;
    636          		if ((wValue == 0) && wIndex && (wIndex <= 3)) {
    637          			pUDP->UDP_CSR[wIndex] = 0;
    638          			AT91F_USB_SendZlp(pUDP);
    639          		}
    640          		else
    641          			AT91F_USB_SendStall(pUDP);
    642          		break;
    643          	case STD_CLEAR_FEATURE_ZERO:
    644                    //Debug code
    645                    if (USBdebug) printf("->case: STD_CLEAR_FEATURE_ZERO");
    646          		AT91F_USB_SendStall(pUDP);
    647          	    break;
    648          	case STD_CLEAR_FEATURE_INTERFACE:
    649                    //Debug code
    650                    if (USBdebug) printf("->case: STD_CLEAR_FEATURE_INTERFACE");
    651          		AT91F_USB_SendZlp(pUDP);
    652          		break;
    653          	case STD_CLEAR_FEATURE_ENDPOINT:
    654                    //Debug code
    655                    if (USBdebug) printf("->case: STD_CLEAR_FEATURE_ENDPOINT");
    656          		wIndex &= 0x0F;
    657          		if ((wValue == 0) && wIndex && (wIndex <= 3)) {
    658          			if (wIndex == 1)
    659          				pUDP->UDP_CSR[1] = (AT91C_UDP_EPEDS | AT91C_UDP_EPTYPE_BULK_OUT);
    660          			else if (wIndex == 2)
    661          				pUDP->UDP_CSR[2] = (AT91C_UDP_EPEDS | AT91C_UDP_EPTYPE_BULK_IN);
    662          			else if (wIndex == 3)
    663          				pUDP->UDP_CSR[3] = (AT91C_UDP_EPEDS | AT91C_UDP_EPTYPE_ISO_IN);
    664          			AT91F_USB_SendZlp(pUDP);
    665          		}
    666          		else
    667          			AT91F_USB_SendStall(pUDP);
    668          		break;
    669          
    670          	// handle CDC class requests
    671          	case SET_LINE_CODING:
    672                    //Debug code
    673                    if (USBdebug) printf("->case: SET_LINE_CODING");
    674          		while ( !(pUDP->UDP_CSR[0] & AT91C_UDP_RX_DATA_BK0) );
    675          		pUDP->UDP_CSR[0] &= ~(AT91C_UDP_RX_DATA_BK0);
    676          		AT91F_USB_SendZlp(pUDP);
    677          		break;
    678          	case GET_LINE_CODING:
    679                    //Debug code
    680                    if (USBdebug) printf("->case: GET_LINE_CODING");
    681          		AT91F_USB_SendData(pUDP, (char *) &line, MIN(sizeof(line), wLength));
    682          		break;
    683          	case SET_CONTROL_LINE_STATE:
    684                    //Debug code
    685                    if (USBdebug) printf("->case: SET_CONTROL_LINE_STATE");
    686          		pCdc->currentConnection = wValue;
    687          		AT91F_USB_SendZlp(pUDP);
    688          		break;
    689          	default:
    690                    //Debug code
    691                    if (USBdebug) printf("->case: ???");
    692          		AT91F_USB_SendStall(pUDP);
    693          	    break;
    694          	}
    695                  if (USBdebug) printf("-> END");
