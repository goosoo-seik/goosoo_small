   1512          void send_network_formation_req(void)
   1513          {
   1514            NLDME_PACKET  P_NWK;
   1515            char  csum = 0;
   1516            char  i;
   1517            API_SERIAL_PACKET TxSerialPkt;
   1518            API_SERIAL_PACKET *pOutPkt = &TxSerialPkt;
   1519            char  *Ptr = (char*)&TxSerialPkt;
   1520            Ptr += 2;
   1521            //->PKT;
   1522            printf("\nPtr: %x", Ptr);
   1523            printf("\n*Ptr: %x", *Ptr);
   1524            printf("\n&TxSerialPkt: %x", &TxSerialPkt);
   1525            printf("\npOutPkt: %x", pOutPkt);
   1526           // printf("\n*pOutPkt: %x", *pOutPkt);
   1527            
   1528            i = sizeof(csum);
   1529          //  i = malloc(csum);
   1530            //P_NWK.NLME_NETWORK_FORMATION_req.ScanChannels = (UINT32)0x01 << 11;
   1531            P_NWK.NLME_NETWORK_FORMATION_req.ScanDuration = 2;
   1532            P_NWK.NLME_NETWORK_FORMATION_req.BeaconOrder = 0x0F;
   1533            P_NWK.NLME_NETWORK_FORMATION_req.SuperframeOrder = 0x0F;
   1534            //P_NWK.NLME_NETWORK_FORMATION_req.PANId = 0x1234;
   1535            P_NWK.NLME_NETWORK_FORMATION_req.BatteryLifeExtension = 0;
   1536            
   1537            pOutPkt->PKT.layer = NWK_LAYER;               // 0x20
   1538            pOutPkt->PKT.Opcode = NLME_NETWORK_FORMATION; // 0x12
   1539            pOutPkt->PKT.Type = REQUEST;                  // 0x10
   1540            pOutPkt->PKT.Size = sizeof(NLME_NETWORK_FORMATION_REQ);
   1541            memcpy(pOutPkt->PKT.Arguments, &P_NWK, pOutPkt->PKT.Size);
   1542            
   1543            pOutPkt->LEN = pOutPkt->PKT.Size + 4;
   1544            
   1545            printf("\n&pOutPkt->PKT.Arguments: %x ", &pOutPkt->PKT.Arguments);
   1546            printf("\n&P_NWK: %02X", &P_NWK);
   1547            printf("\npOutPkt->PKT.Size: %02X", pOutPkt->PKT.Size);
   1548            pOutPkt->LEN = pOutPkt->PKT.Size + 4;
   1549            //
   1550            // Serial Write
   1551            //
   1552            putchar0(STX_ZB);       printf("\n%02X ",STX_ZB);
   1553            putchar0(pOutPkt->LEN); printf("%02X ", pOutPkt->LEN);
   1554            for (i = 0; i < pOutPkt->LEN; i++)
   1555            {
   1556              putchar0(*Ptr);       printf("%02X ", *Ptr);
   1557              csum += *Ptr;
   1558              Ptr++;
   1559            }
   1560            putchar0(csum);         printf("%02X ", csum);
   1561            putchar0(ETX_ZB);       printf("%02X ",ETX_ZB);
   1562          }
   1563          
   1564          #define APP_MAX_DATA_SIZE	(64)
   1565          #define MAX_API_PACKET		(APP_MAX_DATA_SIZE+ 20)
   1566          typedef struct _API_PACKET
   1567          {
   1568              UINT8 layer;
   1569              UINT8 Opcode;
   1570              UINT8 Type;
   1571              UINT8 Size;
   1572              UINT8 Arguments[MAX_API_PACKET];
   1573          } API_PACKET;
   1574          
   1575          typedef struct _API_SERIAL_PACKET
   1576          {
   1577              UINT8 STX;      		// 0xAA	
   1578              UINT8 LEN;      		// Size of PKT		
   1579              API_PACKET PKT; 		// PACKET BUFFER	
   1580              UINT8 SUM;      		// SUM = SUM(PKT), IF SUM == 0, SUM is Ignored
   1581              UINT8 ETX;      		// 0x55
   1582          } API_SERIAL_PACKET;
