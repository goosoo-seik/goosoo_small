//   41 #define	FDATA_SIZE		0x00020000
//   42 #define	EFC_KEY			0x5A << 24
//   43 #define	EFC_WAIT		4 << 8
//   44 
//   45 // Flash Mode
//   46 #define	EFC_FRDY	1		// Flash ready int enable
//   47 #define	EFC_LOCKE_IE	4		// Flash lock error int enable
//   48 #define	EFC_PROGE_IE	8		// Programming error int enable
//   49 #define	EFC_NO_ERASE	0x80		// No erase before programming
//   50 #define	EFC_FLASH_WATE	0x03 << 8       // Flash wait state(0-3)
//   51 #define	EFC_CYCLE_NO	72 << 16	// Flash uSec cycle no
//   52 #define	EFC_MODE_DEFAULT	EFC_CYCLE_NO|EFC_FLASH_WATE	
//   53 
//   54 // Flash Command
//   55 #define	EFC_WRITE_PAGE	1		// Write Page
//   56 #define	EFC_SET_LOCK    2               // Set lock bit
//   57 #define	EFC_WRITE_LOCK  3               // Write page & lock 
//   58 #define	EFC_CLEAR_LOCK  4               // Clear lock bit
//   59 #define	EFC_ERASE_ALL   8               // Erase all
//   60 #define	EFC_SET_NVM     0x0B            // Set GP NVM bit
//   61 #define	EFC_CLEAR_NVM	0x0D		// Clear GP NVM bit
//   62 #define	EFC_SECURITY    0x0F            // Set Security bit
//   63 
//   64 //Flash Status
//   65 #define	EFC_READY	0x00000001	// Flash ready
//   66 #define	EFC_LOCK_ERR	0x00000002      // Lock error
//   67 #define	EFC_PROG_ERR    0x00000004      // Programming error
//   68 #define	EFC_SECU_STS	0x00000008      // Security bit status
//   69 #define	EFC_GPNVM0	0x00000100      // GP NVM bit 0
//   70 #define	EFC_GPNVM1	0x00000200      // GP NVM bit 1
//   71 #define	EFC_GPNVM2	0x00000400      // GP NVM bit 2
//   72 #define	EFC_LOCK	0x00010000      // Lock region(x) lock status
//   73 
