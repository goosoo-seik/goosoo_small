    467          void all_led_onoff(char onoff)
    468          {
    469            if (onoff == 0) 
    470            {
    471             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    472             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED2);
    473             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    474             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    475            } 
    476            else 
    477            {
    478              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    479              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED2 );
    480              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    481              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    482            };
    483          }
    484          
    485          void led_rotate(void)
    486          {
    487            int i;
    488                  // Once a Shot on each led
    489          	for ( i=0 ; i < AT91B_NB_LEB ; i++ )
    490                  {
    491          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    492          	    wait();
    493          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    494          	    wait();
    495                  }// End for
    496                 
    497                  // Once a Shot on each led
    498                  for ( i=(AT91B_NB_LEB-1) ; i >= 0 ; i-- )
    499                  {
    500          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    501          	    wait();
    502          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    503          	    wait();
    504                  } 
    505          }
    506          
    507          //--------------------------------------------------------------------------------------
    508          // Function Name       : change_speed
    509          // Object              : Adjust "LedSpeed" value depending on SW1 and SW2 are pressed or not
    510          // Input Parameters    : none
    511          // Output Parameters   : Update of LedSpeed value.
    512          //--------------------------------------------------------------------------------------
    513          void change_speed ( void )
    514          {
    515              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW1) == 0 )
    516              {
    517                  if ( LedSpeed > SPEED ) LedSpeed -=SPEED ;
    518              }
    519              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW2) == 0 )
    520              {
    521                  if ( LedSpeed < AT91B_MAIN_OSC ) LedSpeed +=SPEED ;
    522              }
    523          }
    524          
    525          //--------------------------------------------------------------------------------------
    526          // Function Name       : wait
    527          // Object              : Software waiting loop
    528          // Input Parameters    : none. Waiting time is defined by the global variable LedSpeed.
    529          // Output Parameters   : none
    530          //--------------------------------------------------------------------------------------
    531          void wait ( void )
    532          {// Begin
    533              unsigned int waiting_time ;
    534              change_speed () ;
    535              for(waiting_time = 0; waiting_time < LedSpeed; waiting_time++) ;
    536          }// End
    537          
    538          void led_shift(void)
    539          {
    540           unsigned char no;
    541            led_onoff(LEDno, LEDon);
    542            no = change_led(LEDno);
    543            if (no != LEDno) 
    544            {
    545              led_onoff(LEDno, 0);
    546              LEDno = no;
    547            }
    548            LEDon ^= 1; 
    549          }
