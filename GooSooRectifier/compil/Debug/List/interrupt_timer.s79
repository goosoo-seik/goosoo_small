// __??Code16?? __code __interwork __atpcs unsigned int AT91F_AIC_ConfigureIt(AT91PS_AIC, unsigned int, unsigned int, unsigned int, void (*)())
AT91F_AIC_ConfigureIt:
        PUSH     {R2,R4-R7}
        MOVS     R2,R0
        MOVS     R4,R1
