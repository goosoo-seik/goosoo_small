   \   00000002   ....               LDR      R2,??DataTable20  ;; `?<Constant "E%02X ">`
   \   00000004   ....               LDR      R1,??DataTable21  ;; 0x44c
   \   00000006   5418               ADDS     R4,R2,R1
   \   00000008   0100               MOVS     R1,R0
   \   0000000A   0023               MOVS     R3,#+0
   \   0000000C   164D               LDR      R5,??ZCM_debug_print_0  ;; ZCMdpMode
   \   0000000E   2E78               LDRB     R6,[R5, #+0]
   \   00000010   002E               CMP      R6,#+0
   \   00000012   04D0               BEQ      ??ZCM_debug_print_1
   \   00000014   012E               CMP      R6,#+1
   \   00000016   12D0               BEQ      ??ZCM_debug_print_2
   \   00000018   022E               CMP      R6,#+2
   \   0000001A   18D0               BEQ      ??ZCM_debug_print_3
   \   0000001C   22E0               B        ??ZCM_debug_print_4
    650            {
    651              
    652              case 0:     
    653                if (c == 0xAA) 
   \                     ??ZCM_debug_print_1:
   \   0000001E   AA28               CMP      R0,#+170
   \   00000020   0BD1               BNE      ??ZCM_debug_print_5
    654                {
    655          	ZCMdpMode = 1;
   \   00000022   0120               MOVS     R0,#+1
   \   00000024   2870               STRB     R0,[R5, #+0]
    656          	printf("\nZCM Packet: ");
   \   00000026   8E20               MOVS     R0,#+142
   \   00000028   C000               LSLS     R0,R0,#+3        ;; #+1136
   \   0000002A   1018               ADDS     R0,R2,R0
   \   0000002C   ........           _BLF     printf,??printf??rT
    657          	printf("%02X ",c);
   \   00000030   AA21               MOVS     R1,#+170
   \   00000032   2000               MOVS     R0,R4
   \                     ??ZCM_debug_print_6:
   \   00000034   ........           _BLF     printf,??printf??rT
   \   00000038   15E0               B        ??ZCM_debug_print_7
    658                } else printf("%c",c);
   \                     ??ZCM_debug_print_5:
   \   0000003A   ....               ADR      R0,??DataTable22  ;; "%c"
   \   0000003C   FAE7               B.N      ??ZCM_debug_print_6
    659                return;
    660                
    661              case 1:
    662                PacketLength = c + 1;
   \                     ??ZCM_debug_print_2:
   \   0000003E   401C               ADDS     R0,R0,#+1
   \   00000040   6870               STRB     R0,[R5, #+1]
    663                ZCMdpMode = 2;
   \   00000042   0220               MOVS     R0,#+2
   \   00000044   2870               STRB     R0,[R5, #+0]
    664                printf("%02X ",c);
   \   00000046   2000               MOVS     R0,R4
   \   00000048   ........           _BLF     printf,??printf??rT
    665                return;
