// 1개의 16x16 hangul font image를 bLCDbuf에 로드
void LCD_hangul_font16_load(short hcode, BYTE curpos)
{
  short width, line, pos, pos_h, lp, dpsize, data , mask;

  width = 8;//16
  dpsize = LCD_LINE_SIZE / width;
  line = curpos / dpsize;
  pos = (curpos % dpsize) * width;
  pos = line * LCD_LINE_SIZE * 2 + pos;
  pos_h = pos - (line * LCD_LINE_SIZE * 2);

  // 남은 LCD width가 font size 보다 작으면 다음 line의 처음으로 위치 변경
  if (pos_h > (LCD_LINE_SIZE - 16)) 
  {
    if (++line > 1) line = 0;
    pos = line * LCD_LINE_SIZE * 2;
  }
  
  // LCD buffer에 1 font image를 copy
  mask = 0;
  if (Blink) if (sCurPos == curpos)  mask = 0xFFFF; 
  
  LCDbuf[pos] = 0;
  LCDbuf[pos + LCD_LINE_SIZE] = 0;
  pos++;
  for (lp = 0; lp < 14; lp++) 
  {
    data = HANGUL_FONT16x16[hcode][lp] ^ mask;
    LCDbuf[pos] = data & 0xFF;
    LCDbuf[pos + LCD_LINE_SIZE] = data >> 8;
    pos++;
  }
  LCDbuf[pos] = 0;
  LCDbuf[pos + LCD_LINE_SIZE] = 0;
}

void LCD_hangul_font_load(BYTE code, char curpos)
{
  unsigned short hcode;
  if (code < 0xA0) LCD_font8x16_load(code, curpos);
   else if (OldCode == 0) OldCode = code;
   else 
      {
        hcode = OldCode - 0xB0;
        hcode = hcode * 94 + (code - 0xA1);
        OldCode = 0;
	LCD_hangul_font16_load(hcode, curpos-1);
      }
}

// if display buffer over, 1 line scroll
void display_buffer_scroll(char size)
{
  short s_add, d_add, lp, line, lp0;
  line = DPBUF_SIZE / size - 1;
  for (lp = 0; lp < line; lp++)
  {
    d_add = lp * size;
    s_add = d_add + size;
    for (lp0 = 0; lp0 < size; lp0++)
    {
      DPbuf[d_add + lp0] = DPbuf[s_add + lp0];
    }
  }
  d_add = DPBUF_SIZE - size;
  for (lp = 0; lp < size; lp++) DPbuf[d_add + lp] = 0;
}

unsigned char display_size(void)
{
  unsigned char dpsize;
  if (FontStyle == 2) dpsize = FONT16_LINE;
   else  if (FontStyle == 1) dpsize = FONT8_LINE;
   else  dpsize = FONT6_LINE;
 return dpsize;
}

unsigned char display_page(void)
{
  unsigned char page;
  if (FontStyle == 2) page = FONT16_PAGE;
   else  if (FontStyle == 1) page = FONT8_PAGE;
   else page = FONT6_PAGE; 
 return page;
}

void cursor_move_left(void)
{
  char dpsize, remain;

  dpsize = display_size();
  remain = sCurPos % dpsize;
  if (remain) sCurPos--;
  DpUpdate = 1;
}

void cursor_move_up(void)
{
  char dpsize;
  
  dpsize = display_size();
  if (sCurPos < dpsize) 
  {
    if (sDPstart >= dpsize) sDPstart = sDPstart - dpsize;
  }
  else sCurPos = sCurPos - dpsize;
  DpUpdate = 1;
}

void cursor_move_right(void)
{
  char dpsize, page;
  
  dpsize = display_size();
  page = display_page();
  
  if (++sCurPos >= page) 
    {
      sDPstart = sDPstart + dpsize;
      //display buffer의 끝이라면, 모든 라인을 스크롤 업
      if (sDPstart >= (DPBUF_SIZE - page)) 
      {
        display_buffer_scroll(dpsize);
        sDPstart = DPBUF_SIZE - page;
      }
      sCurPos = page - dpsize;
    }
  DpUpdate = 1;
}

// 커서를 한줄 아래로 내리기
void cursor_move_down(void)
{
  char dpsize, page;

  dpsize = display_size();
  page = display_page();
  
  sCurPos = sCurPos + dpsize;
  // 페이지 바닥이면, 페이지 전체를 한줄 아래로 이동
  if (sCurPos >= page) 
  {
    sCurPos = sCurPos - dpsize;
    sDPstart = sDPstart + dpsize;
    //display buffer의 끝이라면, 모든 라인을 스크롤 업
    if (sDPstart >= (DPBUF_SIZE - page)) 
    {
      display_buffer_scroll(dpsize);
      sDPstart = DPBUF_SIZE - page;
    }
  }
  DpUpdate = 1;
}

void cursor_move_home(void)
{
  sCurPos = 0;
  DpUpdate = 1;
}

void cursor_move_start(void)
{
  sCurPos = 0;
  sDPstart = 0;
  DpUpdate = 1;
}

void LCD_line_feed(void)
{
  char line, dpsize;
  dpsize = display_size();
  line = sCurPos / dpsize;
  sCurPos = (unsigned char)(line * dpsize);
  cursor_move_down();
  cursor_move_left();
}

void LCD_carrige_return(void)
{
 char line, dpsize;
  dpsize = display_size();
  line = sCurPos / dpsize;
  sCurPos = (unsigned char)(line * dpsize);
  cursor_move_left();
}

/***********************************************/
/*  Charactor store to display buffer(DPbuf[]) */
/* 0: 8x6 ASCII FONT                           */
/* 1: 16x8 ASCII FONT                          */
/* 2: 16x16 HANGUL FONT
/***********************************************/
char CodeOdd, dpsize;
void putchar_one(unsigned short code)
{
  //DpUpdate = 1;
  if (code == '\r')  //0x0D 
  {
    CodeOdd = 0;
    LCD_carrige_return();
  }
  else if (code == '\n') 
  {
    CodeOdd = 0;
    LCD_line_feed();
  }
  else if (code < ' ')		// control code 는 표시하지 않음
  {
    CodeOdd = 0;
  }
  else if (code == ' ')	// 스페이스 처리		 
  {
    // DumpDisplay 이면 첫 스페이스를 무시
    CodeOdd = 0;
    dpsize = display_size();
    //if ((!DumpDisplay)|(code != 0x20)|((sCurPos % dpsize)!= 0))
    if ((!DumpDisplay)|((sCurPos % dpsize)!= 0)) 
     {
      DPbuf[sDPstart + sCurPos] = code;
      cursor_move_right();
     };
  }   
  else if ((code < 0xA0)|(FontStyle != 2))
  { 
    CodeOdd = 0;
    DPbuf[sDPstart + sCurPos] = code;
    cursor_move_right();
  }
  // 한글모드이고 code가 한글 영역인 경우
  else if ((FontStyle == 2)&(code >= 0xA0))
  {
    if (CodeOdd == 0) 
    {
      // 한글전각/영문반각 표시모드일때 
      // 라인의 남은 칸이 반각 한칸뿐이면  스페이스를 삽입
      if ((sCurPos % FONT16_LINE) == (FONT16_LINE - 1)) 
      {
	DPbuf[sDPstart + sCurPos] = ' ';
	cursor_move_right();
      }
      CodeOdd = 1;
      DPbuf[sDPstart + sCurPos] = code;
      cursor_move_right();
    }
    else 
    {
      CodeOdd = 0;
      DPbuf[sDPstart + sCurPos] = code;
      cursor_move_right();
    }
  }
}

unsigned char PutBuf[256];
unsigned char LcdWriteNo, LcdReadNo;
void putchar_dp(unsigned short code)
{
 PutBuf[LcdWriteNo++] = code;
}

void distribute_purchar(void)
{
 if (LcdReadNo != LcdWriteNo) putchar_one(PutBuf[LcdReadNo++]);
 if (LcdReadNo != LcdWriteNo) putchar_one(PutBuf[LcdReadNo++]);
 if (LcdReadNo != LcdWriteNo) putchar_one(PutBuf[LcdReadNo++]);
 if (LcdReadNo != LcdWriteNo) putchar_one(PutBuf[LcdReadNo++]);
}

void print_str(const unsigned char* ptr)
{
  do 
  {
    if (*ptr == '\r') LCD_carrige_return(); 
     else if (*ptr == '\n') LCD_line_feed();   
     else if (*ptr >= ' ') putchar_dp(*ptr);  
  }
  while(*ptr++ != ASC_ETX);         
}

// LCDbuf[] clear
void LCDbuf_clear(void)
{
  short lp;
  unsigned char* ptr = &LCDbuf[0];
  for (lp = 0; lp < LCD_BUF_SIZE; lp++) *ptr++ = 0;
  sLCDpos = 0;
}

// LCDbuf[] clear
void DPbuf_clear(void)
{
  short lp;
  unsigned char* ptr = &DPbuf[0];
  
  for (lp = 0; lp < DPBUF_SIZE; lp++) *ptr++ = 0;
  LcdReadNo = 0;
  LcdWriteNo = 0;
  sCurPos = 0;
  sDPstart = 0;
  DpUpdate = 1;
} 

void screen_clear(void)
{
 unsigned char lp, size, add;
 unsigned char* ptr = &DPbuf[0];
 
 LcdReadNo = 0;
 LcdWriteNo = 0;
 size = display_page();
 for (lp = 0; lp < size; lp++) *ptr++ = 0;
 sDPstart = 0;
 sCurPos = 0;
 OldCode = 0;
 DpUpdate = 1;
}

// LCD module를 data로 채우기
// Test code
void LCD_fill(BYTE byte)
{
  char page, lp;
  for (page = 0; page < 4; page++)
   {
     LCD_cmd_write1(LCD_PAGE_ADD+page);
     LCD_cmd_write1(0);
     for (lp = 0; lp < 61; lp++) LCD_data_write1(byte);
     LCD_cmd_write2(LCD_PAGE_ADD+page);
     LCD_cmd_write2(0); 
     for (lp = 61; lp < 122; lp++) LCD_data_write2(byte);
     LCD_cmd_write3(LCD_PAGE_ADD+page);
     LCD_cmd_write3(0);
     for (lp = 122; lp < 192; lp++) LCD_data_write3(byte);
   }
}
    
// LCD module ON/OFF
void LCD_onoff(BYTE onoff)
{
  if (onoff == ON) onoff = LCD_ON; else onoff = LCD_OFF;
  LCD_cmd_write1(onoff);
  LCD_cmd_write2(onoff);
  LCD_cmd_write3(onoff);
}

void LCD_start_line(BYTE no)
{
  no &= 0x1F;	// LCD start line no = 0 - 31
  LCD_cmd_write1(LCD_DP_START + no);
  LCD_cmd_write2(LCD_DP_START + no);
  LCD_cmd_write3(LCD_DP_START + no);
}

// LCD module GM123210 초기화
void LCD_init(void)
{
  LCD_onoff(OFF);
  delay_us(1000);
  LCD_cmd_write1(LCD_DP_START);
  LCD_cmd_write2(LCD_DP_START);
  LCD_cmd_write3(LCD_DP_START);
  LCD_onoff(ON);
  DPbuf_clear();
  LCDbuf_clear();
  LoadIndex = 0;
  LcdLine = 0;
  LcdBlock = 0;
  powerup_message(); 
  FRONTlamp(ON);
}  

void display_mode(char mode)
{
  DPbuf_clear(); 
  FontStyle = mode; 
  OldCode = 0;
  CodeOdd = 0;
}

