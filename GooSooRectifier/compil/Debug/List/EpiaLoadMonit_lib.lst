    176          /********************************************************************
    177          *  MakeCrc16() : make to cyclic redendancy check 16 
    178          * *ptr로 지정된 번지부터 n byte 의 CRC를 계산해 16bit CRC를 리턴
    179          ********************************************************************/

   \                                 In segment CODE, align 4, keep-with-next
    180          unsigned short	MakeCrc16(unsigned char	*ptr, unsigned short	n)
    181          {
   \                     MakeCrc16:
   \   00000000   30B5               PUSH     {R4,R5,LR}
   \   00000002   0200               MOVS     R2,R0
    182          	unsigned short	crc = 0xffff;
   \   00000004   ....               LDR      R0,??DataTable2  ;; 0xffff
    183          	unsigned short	uitmp;
    184          	unsigned char	uctmp;
    185          
    186          	for(uitmp = 0;uitmp < n;uitmp++)
   \   00000006   0023               MOVS     R3,#+0
   \   00000008   05E0               B        ??MakeCrc16_0
    187          	{
    188          		crc = (crc & 0xff00) | (crc ^ (unsigned short)(ptr[uitmp] & 0xff));
    189          		for(uctmp = 0;uctmp < 8;uctmp++)
    190          		{
    191          			if(crc & 0x0001)
    192          				crc = (crc >> 1) ^ 0xa001;
    193          			else
    194          				crc >>= 1;
   \                     ??MakeCrc16_1:
   \   0000000A   2000               MOVS     R0,R4
   \                     ??MakeCrc16_2:
