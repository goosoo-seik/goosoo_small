//  133 
//  134 /********************************/
//  135 /* LCD Data IN/OUT Functionc    */
//  136 /* For DataImage GM123210       */
//  137 /********************************/
//  138 /********************************************/
//  139 /*  1 byte write to LCD module              */
//  140 /*  data : write date                       */
//  141 /*  sel  : 0-display data, 1-command        */
//  142 /*  ms   : 0-Master(CS1:1), 1-Slave(CS2:1)  */
//  143 /********************************************/
//  144 #ifdef GM123210
//  145 // 1 byte write to LCD module master
//  146 void LCD_write1(BYTE data)
//  147 {
//  148   data &= 0xFF;
//  149   pio_set( PIOB, data );            // data out
//  150   pio_clear( PIOB, data ^ 0xFF );   // data out
//  151   pio_clear( PIOB, LCD_CS1);
//  152   pio_set( PIOB, LCD_CS1);
//  153   pio_clear( PIOB, LCD_CS1);
//  154 }
//  155 
//  156 // 1 byte write to LCD module slave
//  157 void LCD_write2(BYTE data)
//  158 {
//  159   data &= 0xFF;
//  160   pio_set( PIOB, data );            // data out
//  161   pio_clear( PIOB, data ^ 0xFF );   // data out
//  162   pio_clear( PIOB, LCD_CS2);
//  163   pio_set( PIOB, LCD_CS2);
//  164   pio_clear( PIOB, LCD_CS2);
//  165 }
//  166 
//  167 // 1 byte CMD write to LCD module master
//  168 void LCD_cmd_write1(BYTE cmd)
//  169 {
//  170   pio_clear( PIOB, LCD_A0);
//  171   LCD_write1(cmd);
//  172   pio_set( PIOB, LCD_A0);
//  173 }
//  174 
//  175 // 1 byte CMD write to LCD module slave
//  176 void LCD_cmd_write2(BYTE cmd)
//  177 {
//  178   pio_clear( PIOB, LCD_A0);
//  179   LCD_write2(cmd);
//  180   pio_set( PIOB, LCD_A0);
//  181 }
//  182 
