//  170 __ramfunc int AT91F_Flash_Lock_Status(void)
//  171 {
//  172   return( AT91F_MC_EFC_GetStatus( AT91C_BASE_MC ) & AT91C_MC_FSR_LOCK );
AT91F_Flash_Lock_Status:
