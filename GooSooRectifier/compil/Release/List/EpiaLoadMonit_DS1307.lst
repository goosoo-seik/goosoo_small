    951          
    952          				case 'W':
    953          				case 'w':	DS1307_writebyte(0,0);	break;
    954          			}
    955          			break;
    956          
    957          			case 'C':
    958          			case 'c':
    959          			printf("\rEnter Clock Routine to run:C");
    960          			if (bPushKey) M = bPushKey; 
    961          
    962          			switch(M1)
