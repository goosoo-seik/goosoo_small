    372          
    373          void all_led_onoff(char onoff)
    374          {
    375            if (onoff == 0) 
    376            {
    377             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    378             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED2);
    379             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    380             AT91F_PIO_ClearOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    381            } 
    382            else 
    383            {
    384              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED1 );
    385              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED2 );
    386              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED3 );
    387              AT91F_PIO_SetOutput( AT91C_BASE_PIOB, AT91B_LED4 );
    388            };
    389          }
    390          
    391          void led_rotate(void)
    392          {
    393            int i;
    394                  // Once a Shot on each led
    395          	for ( i=0 ; i < AT91B_NB_LEB ; i++ )
    396                  {
    397          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    398          	    wait();
    399          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    400          	    wait();
    401                  }// End for
    402                 
    403                  // Once a Shot on each led
    404                  for ( i=(AT91B_NB_LEB-1) ; i >= 0 ; i-- )
    405                  {
    406          	    AT91F_PIO_ClearOutput( AT91D_BASE_PIO_LED, led_mask[i]) ;
    407          	    wait();
    408          	    AT91F_PIO_SetOutput( AT91D_BASE_PIO_LED, led_mask[i] ) ;
    409          	    wait();
    410                  } 
    411          }
    412          
    413          //--------------------------------------------------------------------------------------
    414          // Function Name       : change_speed
    415          // Object              : Adjust "LedSpeed" value depending on SW1 and SW2 are pressed or not
    416          // Input Parameters    : none
    417          // Output Parameters   : Update of LedSpeed value.
    418          //--------------------------------------------------------------------------------------
    419          void change_speed ( void )
    420          {
    421              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW1) == 0 )
    422              {
    423                  if ( LedSpeed > SPEED ) LedSpeed -=SPEED ;
    424              }
    425              if ( (AT91F_PIO_GetInput(AT91D_BASE_PIO_SW) & AT91B_SW2) == 0 )
    426              {
    427                  if ( LedSpeed < AT91B_MAIN_OSC ) LedSpeed +=SPEED ;
    428              }
    429          }
    430          
    431          //--------------------------------------------------------------------------------------
    432          // Function Name       : wait
    433          // Object              : Software waiting loop
    434          // Input Parameters    : none. Waiting time is defined by the global variable LedSpeed.
    435          // Output Parameters   : none
    436          //--------------------------------------------------------------------------------------
    437          void wait ( void )
    438          {// Begin
    439              unsigned int waiting_time ;
    440              change_speed () ;
    441              for(waiting_time = 0; waiting_time < LedSpeed; waiting_time++) ;
    442          }// End
    443          
    444          void led_shift(void)
    445          {
    446           unsigned char no;
    447            led_onoff(LEDno, LEDon);
    448            no = change_led(LEDno);
    449            if (no != LEDno) 
    450            {
    451              led_onoff(LEDno, 0);
    452              LEDno = no;
    453            }
    454            LEDon ^= 1; 
    455          }
